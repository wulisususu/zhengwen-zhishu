# Runtime secrets belong in ~/.config/ai-box/backend/.env with mode 600.
GLM5_API_KEY=
DESKTOP_INTERNAL_TOKEN=

# 公文起草、政策问答与文稿初稿生成调用的云端政务模型 API（OpenAI 兼容），
# 与设置页「外部模型」同一份配置（app/services/model_config.py）。不使用本地 NPU 模型。
# 需要 config.yaml 中 model.mode: cloud_allowed；offline / intranet 下这些调用会被拒绝、不发请求。
EXTERNAL_MODEL_BASE_URL=https://api.deepseek.com
EXTERNAL_MODEL_NAME=deepseek-chat
EXTERNAL_MODEL_API_KEY=
