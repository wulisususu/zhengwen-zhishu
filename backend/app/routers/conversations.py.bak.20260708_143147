            "conversation": ConversationOut.model_validate(conv).model_dump(mode="json"),
            "grounding": grounding,
        })


    if stream:
        import json as _json
        from app.services.llm_client import ensure_context_answer, generate_stream, generate_stream_with_context

        def sse_gen():
            NL = "\n\n"
            yield _sse_event(_json, _workflow_event(workflow_type, intent_type, {"type": "message_start", "conversation_id": conv_id, "user_message_id": msg.id}), "message_start")
            yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, _user_event_payload(msg, msg_attachments, conv)), ensure_ascii=False) + NL
            for task in attachment_bundle.get("tasks", []):
                if not _should_emit_attachment_task(task, workflow_type, content, audio_attachment_ids):
                    continue
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "file_parse_task", "task": task}), ensure_ascii=False) + NL
            local_bundle = attachment_bundle
            local_context = attachment_context
            full_text = ""
            if attachment_ids and local_bundle.get("pending") and not local_context and not is_python_chat_workflow_enabled():
                local_bundle, wait_text = yield from _stream_wait_for_attachment_bundle_with_workflow(user.id, attachment_ids, content, local_bundle, _json, NL, workflow_type, intent_type)
                local_context = local_bundle.get("context", "")
            if (
