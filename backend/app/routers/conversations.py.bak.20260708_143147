                                    for attempt in attempts:
                                        try:
                                            chunk_stop_reason = ""
                                            chunk_prompt_error = {}
                                            for parsed in iter_openclaw_agent_events(
                                                model=runtime.get("document_model", "openclaw/docgen"),
                                                agent_id=runtime.get("document_agent_id", "docgen"),
                                                input_text=chunk_prompt,
                                                timeout_seconds=runtime.get("timeout_seconds", 180),
                                            ):
                                                if parsed.get("type") == "[DONE]":
                                                    break
                                                payload_obj = parsed.get("payload") or {}
                                                prompt_error = extract_openclaw_prompt_error(payload_obj)
                                                if prompt_error.get("error_type"):
                                                    chunk_prompt_error = prompt_error
                                                    last_error = RuntimeError(prompt_error.get("message") or prompt_error.get("error_type"))
                                                    break
                                                stop_reason = extract_openclaw_stop_reason(payload_obj)
                                                if stop_reason:
                                                    chunk_stop_reason = stop_reason
                                                payload_type = str(payload_obj.get("type") or "").strip()
                                                delta = ""
                                                if payload_type in {"response.output_text.delta", "response.output_text.done"}:
                                                    delta = extract_openclaw_stream_delta(payload_obj)
                                                elif payload_type == "response.completed" and not chunk_text.strip():
                                                    delta = extract_openclaw_completed_text(payload_obj)
                                                if delta:
                                                    openclaw_started_text = True
                                                    chunk_text = merge_openclaw_text_delta(chunk_text, delta)
                                                    candidate = "\n\n".join(
                                                        part.strip()
                                                        for part in [
                                                            summary_text,
                                                            str(generation_state.get("full_markdown") or ""),
