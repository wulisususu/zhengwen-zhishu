                    _trace_doc_stream(conv_id, "before_outline")
                    outline_preview = build_document_outline_preview(content, route, attachment_context=local_context) if should_render_document_outline(content, route, attachment_context=local_context) else None
                    preview_text = render_document_preview_text(content, route, attachment_context=local_context)
                    _trace_doc_stream(conv_id, "after_preview", str(len(preview_text)))
                    logger.info("document_stream_preview conversation=%s chars=%s", conv_id, len(preview_text))
                    for token in emit_text_chunks(preview_text):
