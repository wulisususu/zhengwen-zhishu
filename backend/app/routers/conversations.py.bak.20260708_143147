                                                "request_id": request_id,
                                            },
                                        )
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "error", "error_type": error_type, "message": user_error_text, "retryable": True}), ensure_ascii=False) + NL
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": reply_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                                        yield _sse_event(_json, "[DONE]")
                                        return
                                    force_complete_after_target = bool(generation_state.get("force_complete_after_target"))
                                    generation_state = update_document_generation_state(
                                        generation_state,
                                        chunk_text,
                                        stop_reason=chunk_stop_reason if not force_complete_after_target else "",
                                    )
                                    if force_complete_after_target:
                                        generation_state["status"] = "completed"
                                        generation_state["current_section_id"] = ""
                                        generation_state["is_final_chunk"] = True
                                        generation_state["target_chars_reached"] = True
                                    if (not force_complete_after_target) and should_continue_document_chunk(generation_state, stop_reason=chunk_stop_reason, chunk_text=chunk_text):
                                        logger.info(
                                            "DOC_STREAM: continuing current chunk after stop_reason=%s doc_id=%s chunk_index=%s current_section=%s",
                                            chunk_stop_reason,
                                            conv_id,
                                            generation_state.get("chunk_index"),
                                            generation_state.get("current_section_id"),
                                        )

                                if generation_state.get("status") != "completed":
                                    request_id = f"doc-{conv_id}-{int(time.time())}"
                                    logger.warning(
                                        "DOC_STREAM_INCOMPLETE request_id=%s doc_id=%s status=%s chunk_index=%s max_chunks=%s current_section=%s last_stop_reason=%s",
                                        request_id,
                                        conv_id,
                                        generation_state.get("status"),
                                        generation_state.get("chunk_index"),
                                        max_chunks,
                                        generation_state.get("current_section_id"),
                                        generation_state.get("last_stop_reason"),
                                    )
                                    generation_state["status"] = "partial_failed"
                                    partial_text = prepare_document_text_for_display(
                                        "\n\n".join(part for part in [summary_text, generation_state.get("full_markdown") or ""] if part)
                                    ).strip() or "长文档生成尚未完成，已保留最近一次成功进度，请稍后重试。"
                                    reply = _save_assistant_reply(
                                        db,
                                        conv,
                                        partial_text,
                                        intent_type=intent_type,
                                        metadata={"generation_state": generation_state, "status": "partial_failed", "request_id": request_id},
                                    )
                                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": partial_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                                    yield _sse_event(_json, "[DONE]")
                                    return

                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "checking", "message": "正在检查章节完整性…"}), ensure_ascii=False) + NL
                                final_markdown = prepare_document_markdown_for_render(str(generation_state.get("full_markdown") or ""))
                                final_visible_text = prepare_document_text_for_display(
                                    "\n\n".join(part for part in [summary_text, final_markdown] if part and str(part).strip())
                                )
                                flush_delta = visible_delta_to_emit(final_visible_text, final=True)
                                if flush_delta:
                                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": flush_delta}), ensure_ascii=False) + NL
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "rendering_docx", "message": "正在生成可下载文档…"}), ensure_ascii=False) + NL
                                task, render_result = _render_docx_from_openclaw_body(
                                    runtime=runtime,
                                    conv_id=conv_id,
                                    user_id=user.id,
                                    instruction=content,
                                    content=final_markdown,
                                    attachment_ids=attachment_ids or [],
                                    filename=compact_document_filename(content, final_markdown, max_chars=10),
                                    completion_status="complete",
                                    completion_checklist={
                                        "outline_completed": True,
                                        "chunks_completed": len(generation_state.get("completed_sections") or []),
