                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "error", "content": error_text}), ensure_ascii=False) + NL
                    yield _sse_event(_json, "[DONE]")

            return StreamingResponse(sse_doc_gen(), media_type="text/event-stream",
                                     headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"})

        route = classify_document(
            content,
            attachments=attachment_files,
            attachment_context=attachment_context,
            force_output_format="docx",
        )
        validation = validate_document_route(route, attachment_context=attachment_context, attachments=attachment_files)
