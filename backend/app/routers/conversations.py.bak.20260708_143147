def _make_title(content: str) -> str:
    title = (content or "").strip()
    title = re.sub(r"\s+", " ", title)
    title = re.sub(r"^(?:\u8bf7|\u5e2e\u6211|\u7ed9\u6211)?(?:\u8bb2|\u5199|\u751f\u6210|\u521b\u5efa|\u505a)(?:\u4e00\u4e2a|\u4e00\u7bc7|\u4e00\u4e0b)?", "", title)
    title = re.sub(r"(?:\u7ed9\u6211|\u4e00\u4e0b|\u5427|[\u3002\uff01!\uff1f?])+$", "", title).strip()
    if not title:
        title = (content or "\u65b0\u5bf9\u8bdd").strip()
    return title[:24]


def _normalize_workflow_type(value: str | None, default: str = "chat") -> str:
    workflow = (value or default or "chat").strip().lower().replace("-", "_")
    # knowledge is now an alias for document (unified workflow)
    if workflow == "knowledge":
        workflow = "document"
    return workflow if workflow in _VALID_WORKFLOWS else default


def _workflow_event(workflow_type: str, intent_type: str, payload: dict) -> dict:
    return {"workflow": workflow_type, "intent_type": intent_type, **payload}


def _maybe_update_title(conv: Conversation, content: str, db: Session):
    if (conv.title or "").strip() not in _DEFAULT_TITLES:
        return
    conv.title = _make_title(content)
    conv.updated_at = datetime.utcnow()
    db.add(conv)
    db.commit()
    db.refresh(conv)


def _recent_chat_messages(db: Session, conv_id: int, limit: int = _CHAT_HISTORY_LIMIT) -> list[Message]:
    rows = (
        db.query(Message)
        .filter(Message.conversation_id == conv_id)
        .order_by(Message.id.desc())
        .limit(limit)
        .all()
    )
    return list(reversed(rows))


def _build_chat_prompt(content: str, history: list[Message]) -> str:
    lines = [
        "你是一个自然、稳妥、会承接上下文的中文助手。",
        "规则：",
        "1. 优先直接帮助用户推进，不要因为用户表达简短就只要求补充信息。",
        "2. 如果当前输入含糊，先按常见场景给出可用选项或示例，再请用户选择方向。",
        "3. 如果用户说“继续、后续、这个、它、上面”等，必须结合最近对话理解指代。",
        "4. 回答要中文、具体、可读，不输出思考过程。",
        "",
        "CONVERSATION HISTORY:",
    ]
    for message in history:
        role = "User" if message.role == "user" else "Assistant"
        text = re.sub(r"\s+", " ", (message.content or "")).strip()
        if not text:
            continue
        lines.append(f"{role}: {text[:1200]}")
    lines.extend([
        "",
        "CURRENT USER MESSAGE:",
        (content or "").strip(),
        "",
        "ASSISTANT ANSWER:",
    ])
    prompt = "\n".join(lines)
    if len(prompt) > _CHAT_HISTORY_CHARS:
        head = "\n".join(lines[:7])
        tail = prompt[-(_CHAT_HISTORY_CHARS - len(head) - 16):]
        prompt = head + "\n...\n" + tail
    return prompt


def _normalize_attachment_ids(value) -> list[int]:
    if value is None:
        return []
    if isinstance(value, (int, str)):
        value = [value]
    ids = []
    if isinstance(value, list):
        for item in value:
            try:
                file_id = int(item)
            except Exception:
                continue
            if file_id > 0 and file_id not in ids:
                ids.append(file_id)
    return ids


