                                raw_transcript=str(voice_completion.get("raw_transcript") or voice_payload.get("raw_transcript") or voice_payload.get("transcript") or ""),
                                stages=list(voice_completion.get("stages") or []),
                                latency_ms=dict(voice_completion.get("latency_ms") or {}),
                                revision_id=voice_completion.get("revision_id"),
                            )
                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, audio_done_payload), ensure_ascii=False) + NL
                        full_text = _voice_done_text(voice_kind, voice_payload, full_text)
