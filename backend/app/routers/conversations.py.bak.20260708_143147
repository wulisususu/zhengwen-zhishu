def _attachment_wait_text() -> str:
    return "\u6211\u5148\u89e3\u6790\u4f60\u4e0a\u4f20\u7684\u9644\u4ef6\uff0c\u89e3\u6790\u5b8c\u6210\u540e\u7ee7\u7eed\u56de\u7b54\u3002\n\n"


def _task_signature(task: dict) -> tuple:
    return (
        task.get("status"),
        task.get("progress"),
        task.get("stage"),
        task.get("error"),
    )


def _wait_for_attachment_bundle(user_id: int, attachment_ids: list[int], content: str, bundle: dict) -> dict:
    deadline = time.time() + _ATTACHMENT_WAIT_SECONDS
    current = bundle
    while current.get("pending") and not current.get("context") and time.time() < deadline:
        time.sleep(_ATTACHMENT_POLL_SECONDS)
        current = get_attachment_bundle(user_id, attachment_ids, content, include_visual=False)
    return current


def _stream_wait_for_attachment_bundle(user_id: int, attachment_ids: list[int], content: str, bundle: dict, json_module, nl: str):
    if not attachment_ids or bundle.get("context") or not bundle.get("pending"):
        return bundle, ""

    wait_text = _attachment_wait_text()
    yield "data: " + json_module.dumps({"type": "token", "content": wait_text}, ensure_ascii=False) + nl

    current = bundle
    seen = {task.get("task_id"): _task_signature(task) for task in current.get("tasks", []) if task.get("task_id")}
    deadline = time.time() + _ATTACHMENT_WAIT_SECONDS
    while current.get("pending") and not current.get("context") and time.time() < deadline:
        time.sleep(_ATTACHMENT_POLL_SECONDS)
        current = get_attachment_bundle(user_id, attachment_ids, content, include_visual=False)
        for task in current.get("tasks", []):
            task_id = task.get("task_id")
            if not task_id:
                continue
            signature = _task_signature(task)
            if seen.get(task_id) != signature:
                seen[task_id] = signature
                yield "data: " + json_module.dumps({"type": "file_parse_task", "task": task}, ensure_ascii=False) + nl
    return current, wait_text


def _stream_add_visual_context_if_needed(user_id: int, attachment_ids: list[int], content: str, bundle: dict, json_module, nl: str):
    if not attachment_ids or not should_run_visual_analysis(content, bundle.get("context", "")):
        return bundle, bundle.get("context", ""), ""

    notice = "正在分析PDF页面中的图片、图表和文字关系...\n\n"
    yield "data: " + json_module.dumps({"type": "token", "content": notice}, ensure_ascii=False) + nl
    enhanced = get_attachment_bundle(user_id, attachment_ids, content, include_visual=True)
    return enhanced, enhanced.get("context", ""), notice


def _wrap_sse_chunk(chunk: str, json_module, workflow_type: str, intent_type: str) -> str:
    if not workflow_type:
        return chunk
    try:
        prefix, raw = chunk.split("data: ", 1)
        payload = raw.strip()
        data = json_module.loads(payload)
        if isinstance(data, dict):
            data.setdefault("workflow", workflow_type)
            data.setdefault("intent_type", intent_type)
            return prefix + "data: " + json_module.dumps(data, ensure_ascii=False) + "\n\n"
    except Exception:
        return chunk
    return chunk


def _stream_wait_for_attachment_bundle_with_workflow(user_id: int, attachment_ids: list[int], content: str, bundle: dict, json_module, nl: str, workflow_type: str, intent_type: str):
    source = _stream_wait_for_attachment_bundle(user_id, attachment_ids, content, bundle, json_module, nl)
    try:
        while True:
            chunk = next(source)
            yield _wrap_sse_chunk(chunk, json_module, workflow_type, intent_type)
    except StopIteration as stop:
        return stop.value


def _stream_add_visual_context_if_needed_with_workflow(user_id: int, attachment_ids: list[int], content: str, bundle: dict, json_module, nl: str, workflow_type: str, intent_type: str):
    source = _stream_add_visual_context_if_needed(user_id, attachment_ids, content, bundle, json_module, nl)
    try:
        while True:
            chunk = next(source)
            yield _wrap_sse_chunk(chunk, json_module, workflow_type, intent_type)
    except StopIteration as stop:
        return stop.value


def _merge_message_metadata(existing: str | None, updates: dict | None = None) -> str:
    payload = {}
    if existing:
        try:
            payload = json.loads(existing)
        except Exception:
            payload = {}
    if not isinstance(payload, dict):
        payload = {}
    if updates:
        for key, value in updates.items():
            if value is None:
                continue
            payload[key] = value
    return json.dumps(payload, ensure_ascii=False) if payload else ""


