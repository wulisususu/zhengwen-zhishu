                        if payload_type == "response.output_text.delta":
                            delta = extract_openclaw_stream_delta(payload_obj)
                            if delta:
                                if not emitted_answering_status:
                                    emitted_answering_status = True
                                    logger.info("chat_sse_metric qwen_first_token_latency_ms=%s conversation_id=%s", int((time.monotonic() - qwen_started) * 1000), conv_id)
                                    if status_stream_active:
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "answering", "content": "正在回答…"}), ensure_ascii=False) + NL
                                combined = voice_buffer + delta
                                voice_kind = _voice_prefix_kind(combined)
                                if voice_buffer or voice_kind:
                                    if voice_kind:
                                        voice_buffer = combined
                                        continue
                                    if voice_buffer:
                                        emitted_delta = True
                                        full_text += voice_buffer
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": voice_buffer}), ensure_ascii=False) + NL
                                        voice_buffer = ""
                                emitted_delta = True
                                full_text += delta
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": delta}), ensure_ascii=False) + NL
                        elif payload_type == "response.completed" and not emitted_delta:
                            completed_text = extract_openclaw_completed_text(payload_obj)
                            if completed_text:
                                if not emitted_answering_status:
                                    emitted_answering_status = True
                                    logger.info("chat_sse_metric qwen_first_token_latency_ms=%s conversation_id=%s", int((time.monotonic() - qwen_started) * 1000), conv_id)
                                    if status_stream_active:
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "answering", "content": "正在回答…"}), ensure_ascii=False) + NL
                                if voice_buffer:
                                    full_text = completed_text
                                else:
                                    if _is_openclaw_placeholder_text(completed_text):
                                        full_text = ""
                                        continue
                                    voice_kind = _voice_prefix_kind(completed_text)
                                    if voice_kind:
                                        voice_buffer = completed_text
                                        full_text = completed_text
                                    else:
                                        full_text = completed_text
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": completed_text}), ensure_ascii=False) + NL
                    if voice_buffer and not full_text:
