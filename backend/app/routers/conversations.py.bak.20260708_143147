                                            last_error = RuntimeError("empty chunk response")
                                        except Exception as exc:
                                            last_error = exc
                                            logger.info("DOC_STREAM: OpenClaw chunk attempt failed: chunk=%s attempt=%s error=%r", generation_state.get("chunk_index"), attempt + 1, exc)
                                            if attempt == 0:
                                                continue
                                    if not chunk_ok:
                                        request_id = f"doc-{conv_id}-{int(time.time())}"
                                        error_type = str((chunk_prompt_error or {}).get("error_type") or "").strip()
                                        if not error_type and "context overflow" in str(last_error or "").lower():
                                            error_type = "context_overflow"
                                        error_type = error_type or "chunk_failed"
                                        user_error_text = (
                                            "当前文档生成请求过大，已触发上下文限制，未生成正文。系统已停止本次渲染，请缩短要求或稍后重试。"
                                            if error_type == "context_overflow"
                                            else "长文档生成中断，已保留最近一次成功进度，请稍后重试。"
