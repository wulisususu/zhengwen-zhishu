                yield _sse_event(_json, "[DONE]")
                return
            if workflow_type == "chat" and is_openclaw_chat_enabled():
                status_started = time.monotonic()
                runtime = get_openclaw_chat_runtime()
                history_payload = [
                    {"role": (message.role or "").strip() or "user", "content": message.content or ""}
                    for message in history_messages
                    if (message.content or "").strip()
                ]
                voice_request_active = _is_explicit_asr_request(content) or _is_explicit_tts_request(content)
                status_stream_active = is_chat_status_stream_enabled() and not voice_request_active
                preflight_active = is_chat_preflight_enabled() and not voice_request_active
                preflight = None
                if status_stream_active:
                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "analyzing", "content": "正在分析需求…"}), ensure_ascii=False) + NL
                    logger.info("chat_sse_metric sse_first_status_latency_ms=%s conversation_id=%s", int((time.monotonic() - status_started) * 1000), conv_id)
                if preflight_active:
                    preflight = run_chat_preflight(
                        content,
                        history_messages=history_payload,
                        attachment_context=local_context,
                    )
                    logger.info(
                        "chat_sse_metric small_model_latency_ms=%s small_model_fallback=%s conversation_id=%s error=%s",
                        (preflight or {}).get("latency_ms"),
                        bool((preflight or {}).get("fallback")),
