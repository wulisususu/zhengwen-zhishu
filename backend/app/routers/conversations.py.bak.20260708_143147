                        trace_asr_payload = None if trace_tts_payload else wait_for_asr_result_from_trace(known_call_ids=known_asr_call_ids, wait_seconds=0.6, poll_seconds=0.1)
                        if trace_tts_payload:
                            voice_kind = "tts"
                            voice_payload = trace_tts_payload
                        elif trace_asr_payload:
                            voice_kind = "asr"
                            voice_payload = trace_asr_payload
                    if voice_kind and voice_payload:
