                }
                if preflight:
                    chat_input_kwargs["preflight"] = preflight
                openclaw_input = build_chat_input(content, history_payload, **chat_input_kwargs)
                emitted_delta = False
                emitted_answering_status = False
                qwen_started = time.monotonic()
                voice_buffer = ""
                known_tts_call_ids = load_tool_trace_call_ids("synthesize_speech")
                known_asr_call_ids = load_tool_trace_call_ids("transcribe_audio")
                try:
                    for parsed in iter_openclaw_agent_events(
                        model=runtime.get("chat_model", "openclaw"),
