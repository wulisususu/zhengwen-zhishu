                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, dict(voice_event)), ensure_ascii=False) + NL
                            voice_completion = dict(voice_payload.get("voice_event") or {})
                            audio_done_payload = build_asr_voice_event(
