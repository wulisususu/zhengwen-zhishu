def _sse_event(json_module, payload: dict | str, event: str | None = None) -> str:
    body = payload if isinstance(payload, str) else json_module.dumps(payload, ensure_ascii=False)
    prefix = f"event: {event}\n" if event else ""
    return prefix + "data: " + body + "\n\n"


