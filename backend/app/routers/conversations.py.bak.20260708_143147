                    _trace_doc_stream(conv_id, "after_classify", str((route.get("output_spec") or {}).get("format") or ""))
                    validation = validate_document_route(route, attachment_context=local_context, attachments=attachment_files)
                    _trace_doc_stream(conv_id, "after_validate", validation.get("status") or "")
                    if validation.get("status") != "success":
