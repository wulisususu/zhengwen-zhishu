                        "sources": trace_grounding.get("sources") or [],
                    }
                if not grounding_emitted:
                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "grounding", **grounding}), ensure_ascii=False) + NL
                reply = _save_assistant_reply(db, conv, full_text, intent_type=intent_type)
