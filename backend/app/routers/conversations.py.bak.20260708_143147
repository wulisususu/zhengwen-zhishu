                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "doc_task", "task": task}), ensure_ascii=False) + NL
                                else:
                                    logger.info("DOC_STREAM: OpenClaw document_render_docx invoke did not return a task: %s", str(render_result)[:500])

                            if visible_text.strip() or task:
