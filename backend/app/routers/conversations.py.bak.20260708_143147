                return
            if attachment_ids:
                local_bundle, local_context, visual_notice = yield from _stream_add_visual_context_if_needed_with_workflow(user.id, attachment_ids, content, local_bundle, _json, NL, workflow_type, intent_type)
            if (local_bundle.get("pending") or local_bundle.get("errors")) and local_context:
                note = "还有部分附件未完成解析，下面先基于已解析附件回答。\n\n"
                full_text += note
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": note}), ensure_ascii=False) + NL
            if workflow_type == "pediatric_medical_qa":
                history_payload = [
                    {"role": (message.role or "").strip() or "user", "content": message.content or ""}
                    for message in history_messages
                    if (message.content or "").strip()
                ]
                try:
                    for delta in iter_direct_pediatric_qa_events(
