                                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": visible_delta}), ensure_ascii=False) + NL
                                                    if _openclaw_target_reached(generation_state, chunk_text):
                                                        generation_state["force_complete_after_target"] = True
                                                        chunk_stop_reason = "target_chars_reached"
                                                        break
                                            if chunk_prompt_error.get("error_type"):
