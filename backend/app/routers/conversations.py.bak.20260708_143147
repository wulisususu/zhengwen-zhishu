                        str((preflight or {}).get("error") or "")[:120],
                    )
                    summary = str((preflight or {}).get("summary") or "").strip()
                    if summary:
                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "analysis_summary", "content": summary, "fallback": bool((preflight or {}).get("fallback"))}), ensure_ascii=False) + NL
                if status_stream_active:
                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "generating", "content": "正在生成内容…"}), ensure_ascii=False) + NL
                chat_input_kwargs = {
                    "attachment_context": local_context,
