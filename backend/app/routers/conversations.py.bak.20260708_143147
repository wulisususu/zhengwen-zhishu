                                        "render_after_full_markdown": True,
                                    },
                                    generation_state=generation_state,
                                )
                                if task:
                                    task_id = str(task.get("task_id") or "")
                                    if task_id and task_id not in emitted_task_ids:
                                        emitted_task_ids.add(task_id)
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "doc_task", "task": task}), ensure_ascii=False) + NL
                                else:
                                    logger.info("DOC_STREAM: chunk mode document_render_docx invoke did not return a task: %s", str(render_result)[:500])
                                reply_text = final_visible_text.strip() or "文档正文已生成，文档卡片正在处理中。"
                                reply = _save_assistant_reply(
                                    db,
                                    conv,
                                    reply_text,
                                    intent_type=intent_type,
                                    metadata={"doc_tasks": [task] if task else [], "generation_state": generation_state},
                                )
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": reply_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                                yield _sse_event(_json, "[DONE]")
                                return

                            yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "generating_body", "message": "正在生成正文…"}), ensure_ascii=False) + NL
                            for parsed in iter_openclaw_agent_events(
                                model=runtime.get("document_model", "openclaw/docgen"),
                                agent_id=runtime.get("document_agent_id", "docgen"),
                                input_text=openclaw_input,
                                timeout_seconds=runtime.get("timeout_seconds", 180),
                            ):
                                if parsed.get("type") == "[DONE]":
                                    done_seen = True
                                    break
                                payload_obj = parsed.get("payload") or {}
