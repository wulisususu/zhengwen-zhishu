def _attachment_payloads_for_messages(db: Session, user_id: int, message_ids: list[int]) -> dict[int, list[dict]]:
    if not message_ids:
        return {}
    rows = (
        db.query(MessageAttachment, File)
        .join(File, MessageAttachment.file_id == File.id)
        .filter(MessageAttachment.message_id.in_(message_ids), File.user_id == user_id)
        .order_by(MessageAttachment.id.asc())
        .all()
    )
    grouped: dict[int, list[dict]] = {}
    for link, file in rows:
        grouped.setdefault(link.message_id, []).append(_file_payload(file))
    return grouped


def _valid_attachment_files(db: Session, user_id: int, attachment_ids: list[int]) -> list[File]:
    if not attachment_ids:
        return []
    files = db.query(File).filter(File.user_id == user_id, File.id.in_(attachment_ids)).all()
    by_id = {file.id: file for file in files}
    return [by_id[file_id] for file_id in attachment_ids if file_id in by_id]


def _audio_attachment_ids(files: list[File]) -> list[int]:
    audio_ids: list[int] = []
    for file in files or []:
        filetype = str(getattr(file, "filetype", "") or "").strip().lower()
        suffix = Path(str(getattr(file, "filename", "") or getattr(file, "filepath", "") or "")).suffix.lower()
        if filetype.startswith("audio/") or filetype in _AUDIO_EXTS or suffix in _AUDIO_EXTS:
            audio_ids.append(int(file.id))
    return audio_ids


