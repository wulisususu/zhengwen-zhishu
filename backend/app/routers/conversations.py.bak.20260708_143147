                                        logger.warning(
                                            "DOC_STREAM_PROVIDER_FAILURE provider_url=%s error_type=%s request_id=%s doc_id=%s stage=%s raw_error=%s",
                                            preflight.get("provider_url"),
                                            error_type,
                                            request_id,
                                            conv_id,
                                            generation_state.get("status"),
                                            last_error,
                                        )
                                        generation_state["status"] = "context_overflow" if error_type == "context_overflow" else "partial_failed"
                                        generation_state["last_error_type"] = error_type
                                        generation_state["last_error_message"] = str((chunk_prompt_error or {}).get("message") or last_error or "")
                                        generation_state["render_allowed"] = False
                                        partial_text = prepare_document_text_for_display(
                                            "\n\n".join(part for part in [summary_text, generation_state.get("full_markdown") or ""] if part)
                                        ).strip()
                                        reply_text = "\n\n".join(part for part in [partial_text, user_error_text] if part).strip() or user_error_text
                                        reply = _save_assistant_reply(
                                            db,
                                            conv,
                                            reply_text,
                                            intent_type=intent_type,
