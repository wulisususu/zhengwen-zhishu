                                    chunk_text = ""
                                    chunk_stop_reason = ""
                                    chunk_prompt_error = {}
                                    chunk_ok = False
                                    last_error = None
                                    attempts = range(0) if prompt_budget.get("budget_status") == "overflow_blocked" else range(2)
                                    if prompt_budget.get("budget_status") == "overflow_blocked":
                                        chunk_prompt_error = {
                                            "error_type": "context_overflow",
                                            "message": "chunk prompt budget overflow before OpenClaw request",
                                        }
