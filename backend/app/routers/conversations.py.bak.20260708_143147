                        for eline in event.strip().split("\n"):
                            if eline.startswith("data: "):
                                epayload = eline[6:].strip()
                                if epayload and epayload != "[DONE]":
                                    edata = _json.loads(epayload)
                                    if edata.get("type") == "done":
                                        kb_full_text = edata.get("content", "")
                                        is_done = True
                    except Exception:
                        pass
                    if not is_done:
                        yield event
                from app.database import SessionLocal
                kb_db = SessionLocal()
                try:
                    kb_conv = kb_db.merge(conv)
                    reply = _save_assistant_reply(kb_db, kb_conv, kb_full_text, intent_type=intent_type)
                    kb_db.refresh(reply)
                    reply_id = reply.id
                    reply_created = reply.created_at.isoformat() if reply.created_at else None
                finally:
                    kb_db.close()
                done_payload = _json.dumps({
                    "type": "done", "id": reply_id, "content": kb_full_text,
                    "created_at": reply_created,
                    "conversation": ConversationOut.model_validate(conv).model_dump(mode="json"),
                    "grounded": True, "workflow": workflow_type, "intent_type": intent_type,
                }, ensure_ascii=False)
                yield "data: " + done_payload + NL
                yield _sse_event(_json, "[DONE]")

            return StreamingResponse(sse_kb_gen(), media_type="text/event-stream",
