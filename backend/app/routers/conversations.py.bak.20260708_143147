@router.post("/{conv_id}/messages")
def send_message(conv_id: int, body: dict, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
    conv = db.query(Conversation).filter(Conversation.id == conv_id, Conversation.user_id == user.id).first()
    if not conv:
        return fail(ERR_NOT_FOUND, "conversation not found")

    content = body.get("content", "")

    # Identity question → canned response (before security filter)
    _identity = check_identity(content)
    if _identity:
        msg = Message(conversation_id=conv_id, role="user", content=content, msg_type="text", workflow_type="chat", intent_type="chat")
        conv.updated_at = datetime.utcnow()
        db.add(msg); db.add(conv); db.commit(); db.refresh(msg)
        reply = _save_assistant_reply(db, conv, _identity, intent_type="chat")
        return ok(data={
            "messages": [_message_payload(msg), _message_payload(reply)],
            "conversation": ConversationOut.model_validate(conv).model_dump(mode="json"),
        })

    # Security: input injection filter
    _sec = pre_check(content)
    if not _sec.allowed:
        msg = Message(conversation_id=conv_id, role="user", content=content, msg_type="text", workflow_type=workflow_type or "chat", intent_type="chat")
        conv.updated_at = datetime.utcnow()
        db.add(msg); db.add(conv); db.commit(); db.refresh(msg)
        reply = _save_assistant_reply(db, conv, _sec.block_reason, intent_type="chat")
        return ok(data={
            "messages": [_message_payload(msg), _message_payload(reply)],
            "conversation": ConversationOut.model_validate(conv).model_dump(mode="json"),
        })
    stream = body.get("stream", False)
    requested_workflow = body.get("workflow_type")
    workflow_type = _normalize_workflow_type(requested_workflow) if requested_workflow else _normalize_workflow_type(getattr(conv, "workflow_type", None))
    attachment_ids = _normalize_attachment_ids(body.get("attachments") or body.get("file_ids"))
    attachment_files = _valid_attachment_files(db, user.id, attachment_ids)
    attachment_ids = [file.id for file in attachment_files]
    audio_attachment_ids = _audio_attachment_ids(attachment_files)
    has_attachments = bool(attachment_ids)
    intent_decision = (
        classify_document_intent(content, has_attachments=has_attachments)
        if workflow_type == "document"
        else classify_chat_intent(content, has_attachments=has_attachments)
    )
    intent_type = intent_decision.intent
    msg_attachments = [_file_payload(file) for file in attachment_files]
    if attachment_ids and is_python_chat_workflow_enabled():
        attachment_bundle = {"tasks": [], "pending": attachment_ids, "errors": [], "context": "", "ready_count": 0}
        attachment_context = ""
    else:
        attachment_bundle = get_attachment_bundle(user.id, attachment_ids, content, include_visual=not stream) if attachment_ids else {
            "tasks": [], "pending": [], "errors": [], "context": "", "ready_count": 0,
        }
        attachment_context = attachment_bundle.get("context", "")
    had_messages = db.query(Message.id).filter(Message.conversation_id == conv_id).first() is not None
    history_messages = _recent_chat_messages(db, conv_id) if had_messages else []

    msg = Message(
        conversation_id=conv_id,
        role="user",
        content=content,
        msg_type="text",
        workflow_type=workflow_type,
        intent_type=intent_type,
    )
    conv.updated_at = datetime.utcnow()
    db.add(msg)
    db.add(conv)
    db.flush()
    for file in attachment_files:
        db.add(MessageAttachment(message_id=msg.id, file_id=file.id))
    db.commit()
    db.refresh(msg)

    if not had_messages:
        _maybe_update_title(conv, content, db)

    chat_prompt = _build_chat_prompt(content, history_messages)

    # -- PI Agent chat -------- (Feature Flag ----) --
    if _use_pi_agent_chat() and workflow_type == "chat":
        _trace_doc_stream(conv_id, "pi_agent_chat_stream")
        async def _pi_chat_sse_gen():
            import json as _json
            full_text = ""
            async for sse_frame in chat_with_degradation(
                content=content,
                user_id=user.id,
                conversation_id=conv_id,
                message_id=msg.id,
                attachment_context=attachment_context,
                conversation_data=ConversationOut.model_validate(conv).model_dump(mode="json"),
                msg_attachments=msg_attachments,
            ):
                # Accumulate text from token frames; pass everything through
                stripped = sse_frame.strip()
                if stripped.startswith("data: ") and stripped != "data: [DONE]":
                    try:
                        payload_str = stripped[6:]
                        obj = _json.loads(payload_str)
                        if obj.get("type") == "token":
                            full_text += obj.get("content", "")
                    except Exception:
                        pass
                # Don't yield the final [DONE] or done from degradation.py;
                # we'll emit our own after DB save
                if stripped == "data: [DONE]":
                    continue
                if stripped.startswith("data: "):
                    try:
                        obj2 = _json.loads(stripped[6:])
                        if obj2.get("type") == "done":
                            continue  # replace with our own
                    except Exception:
                        pass
                yield sse_frame
            # Save assistant reply to DB
            reply = _save_assistant_reply(db, conv, full_text, intent_type=intent_type)
            yield _sse_event(_json, _workflow_event(workflow_type, intent_type, {
                "type": "done",
                "id": reply.id,
                "content": full_text,
                "conversation": ConversationOut.model_validate(conv).model_dump(mode="json"),
            }))
            yield _sse_event(_json, "[DONE]")
        return StreamingResponse(
            _pi_chat_sse_gen(),
            media_type="text/event-stream",
            headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"},
        )

    if attachment_ids and not stream and attachment_bundle.get("pending") and not attachment_context:
        attachment_bundle = _wait_for_attachment_bundle(user.id, attachment_ids, content, attachment_bundle)
        attachment_context = attachment_bundle.get("context", "")

    if (
        attachment_ids
        and not is_python_chat_workflow_enabled()
        and (attachment_bundle.get("pending") or attachment_bundle.get("errors"))
        and not attachment_context
        and (not stream or not attachment_bundle.get("pending"))
        and not _should_bypass_audio_parse_failure(workflow_type, content, audio_attachment_ids)
    ):
        import json as _json

        pending_text = _pending_attachment_text(attachment_bundle)
        if stream:
            def sse_attachment_pending_gen():
                NL = "\n\n"
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, _user_event_payload(msg, msg_attachments, conv)), ensure_ascii=False) + NL
                for task in attachment_bundle.get("tasks", []):
                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "file_parse_task", "task": task}), ensure_ascii=False) + NL
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": pending_text}), ensure_ascii=False) + NL
                reply = Message(conversation_id=conv_id, role="assistant", content=pending_text, msg_type="text", workflow_type=workflow_type, intent_type=intent_type)
                conv.updated_at = datetime.utcnow()
                db.add(reply)
                db.add(conv)
                db.commit()
                db.refresh(reply)
                db.refresh(conv)
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": pending_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                yield _sse_event(_json, "[DONE]")

            return StreamingResponse(sse_attachment_pending_gen(), media_type="text/event-stream",
                                     headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"})

        reply = Message(conversation_id=conv_id, role="assistant", content=pending_text, msg_type="text", workflow_type=workflow_type, intent_type=intent_type)
        conv.updated_at = datetime.utcnow()
        db.add(reply)
        db.add(conv)
        db.commit()
        db.refresh(reply)
        db.refresh(conv)
        return ok(data={
            "messages": [_message_payload(msg, msg_attachments), _message_payload(reply)],
            "conversation": ConversationOut.model_validate(conv).model_dump(mode="json"),
            "file_parse_tasks": attachment_bundle.get("tasks", []),
        })

    if workflow_type == "chat" and intent_type == "handoff_to_document":
        import json as _json

        handoff_text = _document_handoff_text(content)
        if stream:
            def sse_handoff_gen():
                NL = "\n\n"
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, _user_event_payload(msg, msg_attachments, conv)), ensure_ascii=False) + NL
                event = {
                    "type": "workflow_handoff",
                    "target_workflow": "document",
                    "suggested_prompt": content,
                    "content": handoff_text,
                }
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, event), ensure_ascii=False) + NL
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": handoff_text}), ensure_ascii=False) + NL
                reply = _save_assistant_reply(db, conv, handoff_text, intent_type=intent_type)
                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": handoff_text, "created_at": reply.created_at.isoformat() if reply.created_at else None, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                yield _sse_event(_json, "[DONE]")

            return StreamingResponse(sse_handoff_gen(), media_type="text/event-stream",
                                     headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"})

        reply = _save_assistant_reply(db, conv, handoff_text, intent_type=intent_type)
        return ok(data={
            "messages": [_message_payload(msg, msg_attachments), _message_payload(reply)],
            "conversation": ConversationOut.model_validate(conv).model_dump(mode="json"),
            "workflow_handoff": {"target_workflow": "document", "suggested_prompt": content},
        })

    if workflow_type == "document" and intent_decision.use_document_agent:
        import json as _json

        def emit_text_chunks(text: str, chunk_size: int = 12):
            for index in range(0, len(text), chunk_size):
                yield text[index:index + chunk_size]


        if stream:
            async def sse_doc_gen():
                NL = "\n\n"
                try:
                    _trace_doc_stream(conv_id, "stream_enter")
                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, _user_event_payload(msg, msg_attachments, conv)), ensure_ascii=False) + NL
                    _trace_doc_stream(conv_id, "user_emitted")
                    preface_text = _build_document_preface(content)
                    if preface_text:
                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "message_start", "role": "assistant"}), ensure_ascii=False) + NL
                        for token in emit_text_chunks(preface_text, chunk_size=6):
                            yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": token}), ensure_ascii=False) + NL
                            time.sleep(0.02)
                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "analyzing", "message": "正在分析你的文档需求…"}), ensure_ascii=False) + NL
                        _trace_doc_stream(conv_id, "preface_emitted", preface_text[:80])
                    for task in attachment_bundle.get("tasks", []):
                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "file_parse_task", "task": task}), ensure_ascii=False) + NL
                    local_bundle = attachment_bundle
                    local_context = attachment_context
                    full_text = ""
                    if attachment_ids and local_bundle.get("pending") and not local_context:
                        _swfabw_source = _stream_wait_for_attachment_bundle(user.id, attachment_ids, content, local_bundle, _json, NL)
                        try:
                            while True:
                                _chunk = next(_swfabw_source)
                                yield _wrap_sse_chunk(_chunk, _json, workflow_type, intent_type)
                        except StopIteration as _stop:
                            local_bundle, wait_text = _stop.value
                        local_context = local_bundle.get("context", "")
                    if (
                        attachment_ids
                        and (local_bundle.get("pending") or local_bundle.get("errors"))
                        and not local_context
                        and not _should_bypass_audio_parse_failure(workflow_type, content, audio_attachment_ids)
                    ):
                        failure_text = _pending_attachment_text(local_bundle)
                        reply_text = "\n\n".join(part for part in [preface_text, failure_text] if part).strip()
                        if failure_text:
                            yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": "\n\n" + failure_text}), ensure_ascii=False) + NL
                            full_text = reply_text
                        reply = _save_assistant_reply(db, conv, full_text, intent_type=intent_type)
                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": full_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                        yield _sse_event(_json, "[DONE]")
                        return
                    if attachment_ids:
                        _savcinw_source = _stream_add_visual_context_if_needed(user.id, attachment_ids, content, local_bundle, _json, NL)
                        try:
                            while True:
                                _chunk = next(_savcinw_source)
                                yield _wrap_sse_chunk(_chunk, _json, workflow_type, intent_type)
                        except StopIteration as _stop:
                            local_bundle, local_context, visual_notice = _stop.value

                    # ── PI Agent doc 主路径（Feature Flag 控制）──
                    if _use_pi_agent_doc():
                        _trace_doc_stream(conv_id, "pi_agent_doc_stream")
                        doc_full_text = ""
                        async for sse_frame in doc_with_degradation(
                            content=content,
                            user_id=user.id,
                            conversation_id=conv_id,
                            message_id=msg.id,
                            attachment_ids=attachment_ids,
                            attachment_context=local_context,
                            attachment_files=attachment_files,
                            conversation_data=ConversationOut.model_validate(conv).model_dump(mode="json"),
                            msg_attachments=msg_attachments,
                        ):
                            # Accumulate text from token frames; pass everything through
                            stripped = sse_frame.strip()
                            if stripped.startswith("data: ") and stripped != "data: [DONE]":
                                try:
                                    obj = _json.loads(stripped[6:])
                                    if obj.get("type") == "token":
                                        doc_full_text += obj.get("content", "")
                                except Exception:
                                    pass
                            # Filter out done/[DONE]; we emit DB-backed versions after save
                            if stripped == "data: [DONE]":
                                continue
                            if stripped.startswith("data: "):
                                try:
                                    obj2 = _json.loads(stripped[6:])
                                    if obj2.get("type") == "done":
                                        continue
                                except Exception:
                                    pass
                            yield sse_frame
                        # Save assistant reply to DB
                        reply = _save_assistant_reply(db, conv, doc_full_text, intent_type=intent_type)
                        yield _sse_event(_json, _workflow_event(workflow_type, intent_type, {
                            "type": "done",
                            "id": reply.id,
                            "content": doc_full_text,
                            "conversation": ConversationOut.model_validate(conv).model_dump(mode="json"),
                        }))
                        yield _sse_event(_json, "[DONE]")
                        return

                    # Prefer OpenClaw docgen when enabled; keep MiniCPM/Python task flow below as fallback.
                    if is_openclaw_document_enabled():
                        _trace_doc_stream(conv_id, "openclaw_document_agent_stream")
                        openclaw_started_text = False
                        try:
                            runtime = get_openclaw_document_runtime()
                            openclaw_input = build_document_input(
                                content=content,
                                conversation_id=conv_id,
                                user_id=user.id,
                                attachment_ids=attachment_ids or [],
                                attachment_context=local_context,
                            )
                            task = None
                            emitted_task_ids: set[str] = set()
                            done_seen = False
                            emitted_visible_text = preface_text or ""
                            stream_guard_chars = 80
                            requested_chars_match = re.search(r"(\d{2,5})\s*(?:字|字符|汉字|word|words)", content, flags=re.IGNORECASE)
                            requested_chars = int(requested_chars_match.group(1)) if requested_chars_match else 0

                            def _openclaw_target_reached(state: dict, current_chunk: str) -> bool:
                                if requested_chars <= 0:
                                    return False
                                combined = "\\n\\n".join(
                                    part.strip()
                                    for part in [str((state or {}).get("full_markdown") or ""), clean_document_chunk_output(current_chunk)]
                                    if part and str(part).strip()
                                )
                                visible_len = len(prepare_document_text_for_display(combined))
                                target = max(1800, requested_chars)
                                return visible_len >= target

                            def visible_delta_to_emit(visible_text: str, *, final: bool = False) -> str:
                                nonlocal emitted_visible_text
                                target = visible_text
                                if not final and len(target) > stream_guard_chars:
                                    target = target[:-stream_guard_chars]
                                elif not final:
                                    target = ""
                                if not target or target == emitted_visible_text:
                                    return ""
                                if target.startswith(emitted_visible_text):
                                    delta_text = target[len(emitted_visible_text):]
                                    emitted_visible_text = target
                                    return delta_text
                                if emitted_visible_text.startswith(target):
                                    return ""
                                prefix_len = 0
                                max_prefix = min(len(target), len(emitted_visible_text))
                                while prefix_len < max_prefix and target[prefix_len] == emitted_visible_text[prefix_len]:
                                    prefix_len += 1
                                delta_text = target[prefix_len:]
                                emitted_visible_text = target
                                return delta_text

                            preflight = preflight_openclaw_provider(
                                agent_id=runtime.get("document_agent_id", "docgen"),
                                timeout_seconds=5,
                            )
                            if not preflight.get("ok", True):
                                request_id = f"doc-{conv_id}-{int(time.time())}"
                                logger.warning(
                                    "DOC_STREAM_PROVIDER_FAILURE provider_url=%s error_type=%s request_id=%s doc_id=%s stage=%s raw_error=%s",
                                    preflight.get("provider_url"),
                                    preflight.get("error_type"),
                                    request_id,
                                    conv_id,
                                    preflight.get("stage"),
                                    preflight.get("raw_error"),
                                )
                                _trace_doc_stream(
                                    conv_id,
                                    "provider_unavailable",
                                    f"provider_url={preflight.get('provider_url')} error_type={preflight.get('error_type')} request_id={request_id} stage={preflight.get('stage')}",
                                )
                                failure_text = str(preflight.get("message") or "大模型服务当前不可用，请检查 192.168.0.212:8081")
                                reply_text = "\n\n".join(part for part in [preface_text, failure_text] if part).strip()
                                reply = _save_assistant_reply(
                                    db,
                                    conv,
                                    reply_text,
                                    intent_type=intent_type,
                                    metadata={"provider_error": preflight, "request_id": request_id},
                                )
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": "\n\n" + failure_text}), ensure_ascii=False) + NL
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": reply_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                                yield _sse_event(_json, "[DONE]")
                                return

                            if should_use_document_chunk_mode(content):
                                _trace_doc_stream(conv_id, "openclaw_chunk_mode_enter")
                                summary_text = preface_text or constrain_document_summary("")

                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "extracting", "message": "正在提取标题和必备章节…"}), ensure_ascii=False) + NL
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "planning", "message": "正在规划文档结构…"}), ensure_ascii=False) + NL
                                # Keep OpenClaw/Qwen35B responsible for body generation, but avoid blocking
                                # the browser on a separate remote outline-only request before any task exists.
                                outline_payload = build_fallback_document_outline(content)
                                _trace_doc_stream(conv_id, "outline_local_fallback")
                                generation_state = create_document_generation_state(
                                    doc_id=conv_id,
                                    outline=outline_payload.get("outline") or build_fallback_document_outline(content).get("outline") or [],
                                    title=str(outline_payload.get("title") or compact_document_filename(content, max_chars=10) or "正式文档"),
                                )
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "preparing_body", "message": "正在准备正文开头…"}), ensure_ascii=False) + NL
                                max_chunks = max(6, int(generation_state.get("estimated_total_chunks") or 1) * 4 + 4)
                                while generation_state.get("status") != "completed" and int(generation_state.get("chunk_index") or 0) < max_chunks:
                                    outline_sections = generation_state.get("outline") or []
                                    completed_count = len(generation_state.get("completed_sections") or [])
                                    remaining_count = max(1, len(outline_sections) - completed_count)
                                    generation_state["is_final_chunk"] = remaining_count <= 1
                                    generation_state["status"] = f"generating_chunk_{int(generation_state.get('chunk_index') or 0) + 1}"
                                    status_message = "正在生成正文…" if int(generation_state.get("chunk_index") or 0) == 0 else "正在按章节继续生成…"
                                    yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": generation_state["status"], "message": status_message}), ensure_ascii=False) + NL
                                    chunk_prompt = build_document_chunk_input(
                                        content=content,
                                        generation_state=generation_state,
                                        conversation_id=conv_id,
                                        user_id=user.id,
                                        attachment_context=local_context,
