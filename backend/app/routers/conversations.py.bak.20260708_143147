    return {
        "id": file.id,
        "filename": file.filename,
        "size": file.filesize,
        "type": file.filetype,
        "download_url": f"/api/v1/files/{file.id}/download",
    }


def _message_payload(message: Message, attachments: list[dict] | None = None) -> dict:
