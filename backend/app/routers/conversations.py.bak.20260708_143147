                        reply = _save_assistant_reply(db, conv, full_text, intent_type=intent_type)
                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": full_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
