                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": reply_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                                yield _sse_event(_json, "[DONE]")
                                return
                            failure_text = "OpenClaw 文档 Agent 调用失败，请稍后重试。"
                            reply = _save_assistant_reply(db, conv, failure_text, intent_type=intent_type)
                            yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": failure_text}), ensure_ascii=False) + NL
                            yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "done", "id": reply.id, "content": failure_text, "conversation": ConversationOut.model_validate(conv).model_dump(mode="json")}), ensure_ascii=False) + NL
                            yield _sse_event(_json, "[DONE]")
