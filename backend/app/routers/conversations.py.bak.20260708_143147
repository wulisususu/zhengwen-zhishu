def _extract_document_required_sections(prompt: str, *, limit: int = 8) -> list[str]:
    text = str(prompt or "").strip()
    if not text:
        return []
    marker = re.search(r"(?:文档)?(?:要求)?(?:需要)?包含[：:\s]*|包括[：:\s]*|内容包括[：:\s]*", text)
    if not marker:
        return []
    tail = text[marker.end():]
    tail = re.split(r"\n\s*(?:字数|不少于|要求|部署环境|模型|输出格式|项目规模)\b|。", tail, maxsplit=1)[0]
    candidates = re.split(r"[\n,，、;；]+|\d+[\.、)]\s*", tail)
    sections: list[str] = []
    for item in candidates:
        value = re.sub(r"^[\-*•\s]+", "", item).strip(" ：:，,。；;")
        value = re.sub(r"^(?:第[一二三四五六七八九十\d]+章\s*)", "", value).strip()
        if not value or len(value) > 24:
            continue
        if any(skip in value for skip in ("不少于", "字", "docx", "Word", "生成", "要求")):
            continue
        if value not in sections:
            sections.append(value)
        if len(sections) >= limit:
            break
    return sections


def _build_document_preface(prompt: str) -> str:
    prompt_text = str(prompt or "")
    quoted = re.search(r"[《“\"]([^》”\"]{2,40})[》”\"]", prompt_text)
    quoted_title = quoted.group(1).strip() if quoted else ""
    if quoted_title and "软件需求说明书" in prompt_text and "软件需求说明书" not in quoted_title:
        title = f"{quoted_title}软件需求说明书"
    elif quoted_title and "投标文件" in prompt_text and "投标文件" not in quoted_title:
        title = f"{quoted_title}投标文件"
    else:
        title = compact_document_filename(prompt, max_chars=18) or quoted_title or "正式文档"
    sections = _extract_document_required_sections(prompt)
    if sections:
        section_text = "、".join(sections[:5])
        return f"我会为你生成《{title}》，内容将覆盖{section_text}等部分，并在完成后生成可下载文档。"
    return f"我会为你生成《{title}》，并在完成正文后生成可下载文档。"


def _render_docx_from_openclaw_body(
    *,
    runtime: dict,
    conv_id: int,
    user_id: int,
    instruction: str,
    content: str,
    attachment_ids: list[int] | None = None,
    filename: str = "",
    completion_status: str = "",
    completion_checklist: dict | None = None,
    generation_state: dict | None = None,
) -> tuple[dict | None, dict]:
    render_args = {
        "conversation_id": conv_id,
        "user_id": user_id,
        "instruction": instruction,
        "content": content,
        "content_type": "markdown",
        "attachments": attachment_ids or [],
    }
    if filename:
        render_args["filename"] = filename
    if completion_status:
        render_args["completion_status"] = completion_status
    if completion_checklist:
        render_args["completion_checklist"] = completion_checklist
    if generation_state:
        render_args["generation_state"] = generation_state
    render_result = invoke_openclaw_tool(
        name="document_render_docx",
        agent_id=runtime.get("document_agent_id", "docgen"),
        args=render_args,
        timeout_seconds=60,
    )
    render_data = extract_openclaw_tool_result_data(render_result)
    task = extract_document_task_payload(render_data)
    if task:
        return task, render_result

    # Same tool endpoint, bridge-side retry only when OpenClaw plugin context loses auth/config.
    bridge_result = invoke_backend_document_render_docx(render_args, timeout_seconds=60)
    task = extract_document_task_payload((bridge_result or {}).get("data") or bridge_result)
    if task:
        return task, bridge_result
    return None, render_result


def _voice_prefix_kind(text: str) -> str:
    value = str(text or "")
    if not value:
        return ""
    if "audio_bytes=".startswith(value) or value.startswith("audio_bytes="):
        return "tts"
    if "ASR_OK:".startswith(value) or value.startswith("ASR_OK:"):
        return "asr"
    return ""


def _voice_completion_kind(text: str) -> str:
    value = str(text or "").strip()
    if value.startswith("audio_bytes="):
        return "tts"
    if value.startswith("ASR_OK:"):
        return "asr"
    return ""


def _voice_done_text(capability: str, payload: dict | None, fallback_text: str) -> str:
    normalized_capability = str(capability or "").strip()
    payload = payload or {}
    if normalized_capability == "asr":
        transcript = str(payload.get("transcript") or "").strip()
        if transcript:
            return transcript
    if normalized_capability == "tts":
        return "语音已生成，请点击播放。"
    return str(fallback_text or "").strip()


def _is_openclaw_placeholder_text(text: str) -> bool:
    return str(text or "").strip() == "No response from OpenClaw."


def _should_bypass_audio_parse_failure(workflow_type: str, content: str, audio_file_ids: list[int]) -> bool:
    return workflow_type == "chat" and bool(audio_file_ids) and _is_explicit_asr_request(content)


def _should_emit_attachment_task(task: dict, workflow_type: str, content: str, audio_file_ids: list[int]) -> bool:
    if not _should_bypass_audio_parse_failure(workflow_type, content, audio_file_ids):
        return True
    task_file_id = task.get("file_id")
    try:
        normalized_file_id = int(task_file_id)
    except Exception:
        return True
    return normalized_file_id not in audio_file_ids


@router.get("")
def list_conversations(
    limit: int | None = Query(None, ge=1, le=100),
    offset: int = Query(0, ge=0),
    workflow_type: str | None = Query(None),
    user: User = Depends(get_current_user),
    db: Session = Depends(get_db),
):
    has_messages = db.query(Message.id).filter(Message.conversation_id == Conversation.id).exists()
    query = (
        db.query(Conversation)
        .filter(Conversation.user_id == user.id)
        .filter(has_messages | ~Conversation.title.in_(_DEFAULT_TITLES))
        .order_by(Conversation.updated_at.desc())
    )
    if workflow_type:
        query = query.filter(Conversation.workflow_type == _normalize_workflow_type(workflow_type))
    if limit is None:
        convs = query.all()
        return ok(data=[ConversationOut.model_validate(c).model_dump() for c in convs])

    convs = query.offset(offset).limit(limit + 1).all()
    has_more = len(convs) > limit
    items = convs[:limit]
    return ok(data={
        "items": [ConversationOut.model_validate(c).model_dump() for c in items],
        "limit": limit,
        "offset": offset,
        "next_offset": offset + len(items),
        "has_more": has_more,
    })


@router.post("")
def create_conversation(body: ConversationCreate, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
    conv = Conversation(
        user_id=user.id,
        title=body.title,
        workflow_type=_normalize_workflow_type(getattr(body, "workflow_type", None)),
    )
    db.add(conv)
    db.commit()
    db.refresh(conv)
    return ok(data=ConversationOut.model_validate(conv).model_dump(mode="json"))


@router.delete("/{conv_id}")
def delete_conversation(conv_id: int, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
    conv = db.query(Conversation).filter(Conversation.id == conv_id, Conversation.user_id == user.id).first()
    if not conv:
        return fail(ERR_NOT_FOUND, "conversation not found")
    message_ids = [row[0] for row in db.query(Message.id).filter(Message.conversation_id == conv_id).all()]
    if message_ids:
        db.query(MessageAttachment).filter(MessageAttachment.message_id.in_(message_ids)).delete(synchronize_session=False)
    db.query(Message).filter(Message.conversation_id == conv_id).delete(synchronize_session=False)
    db.delete(conv)
    db.commit()
    return ok(message="deleted")


@router.get("/{conv_id}/messages")
