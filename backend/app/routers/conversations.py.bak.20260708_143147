                                if detected_task:
                                    task_id = str(detected_task.get("task_id") or "")
                                    task = detected_task
                                    if task_id and task_id not in emitted_task_ids:
                                        emitted_task_ids.add(task_id)
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "doc_task", "task": task}), ensure_ascii=False) + NL

                                payload_type = str(payload_obj.get("type") or "").strip()
                                delta = ""
                                if payload_type in {"response.output_text.delta", "response.output_text.done"}:
                                    delta = extract_openclaw_stream_delta(payload_obj)
                                elif payload_type == "response.completed":
                                    completed_text = extract_openclaw_completed_text(payload_obj)
                                    if completed_text and not full_text.strip():
                                        delta = completed_text
                                if delta:
                                    openclaw_started_text = True
                                    full_text = merge_openclaw_text_delta(full_text, delta)
                                    visible_text = prepare_document_text_for_display(full_text)
                                    visible_delta = visible_delta_to_emit(visible_text)
                                    if visible_delta:
                                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": visible_delta}), ensure_ascii=False) + NL
                                    if find_document_render_tail_index(full_text) >= 0:
                                        break

                            visible_text = prepare_document_text_for_display(full_text)
                            visible_delta = visible_delta_to_emit(visible_text, final=True)
                            if visible_delta:
                                openclaw_started_text = True
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": visible_delta}), ensure_ascii=False) + NL

                            if full_text.strip() and not task:
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "status", "stage": "rendering_docx", "message": "正在生成可下载文档…"}), ensure_ascii=False) + NL
                                render_content = prepare_document_markdown_for_render(full_text)
                                detected_task, render_result = _render_docx_from_openclaw_body(
                                    runtime=runtime,
                                    conv_id=conv_id,
                                    user_id=user.id,
                                    instruction=content,
                                    content=render_content or visible_text.strip() or full_text.strip(),
