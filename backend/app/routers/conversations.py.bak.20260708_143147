                try:
                    for parsed in iter_openclaw_agent_events(
                        model=runtime.get("knowledge_model", "openclaw"),
                        agent_id=runtime.get("knowledge_agent_id", "main"),
                        input_text=openclaw_input,
                        timeout_seconds=runtime.get("timeout_seconds", 180),
                    ):
                        if parsed.get("type") == "[DONE]":
                            break
                        payload_obj = parsed.get("payload") or {}
                        grounding_payload = extract_kb_grounding_payload(payload_obj)
                        if grounding_payload and not grounding_emitted:
                            grounding = {
                                "grounded": bool(grounding_payload.get("grounded")),
                                "source_count": int(grounding_payload.get("source_count") or 0),
                                "sources": grounding_payload.get("sources") or [],
                            }
                            grounding_emitted = True
                            yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "grounding", **grounding}), ensure_ascii=False) + NL
                        payload_type = str(payload_obj.get("type") or "").strip()
                        if payload_type == "response.output_text.delta":
                            delta = extract_openclaw_stream_delta(payload_obj)
                            if delta:
                                emitted_delta = True
                                full_text += delta
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": delta}), ensure_ascii=False) + NL
                        elif payload_type == "response.completed" and not emitted_delta:
                            completed_text = extract_openclaw_completed_text(payload_obj)
                            if completed_text:
                                full_text = completed_text
                                yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": completed_text}), ensure_ascii=False) + NL
                    if not full_text.strip():
                        full_text = fallback_text
                        yield "data: " + _json.dumps(_workflow_event(workflow_type, intent_type, {"type": "token", "content": full_text}), ensure_ascii=False) + NL
                except Exception:
