    if resp.status_code != 200:
        yield {"error": "Model HTTP %d: %s" % (resp.status_code, resp.text[:200])}
        return

    def raw_chunks():
        for line in resp.iter_lines(decode_unicode=True):
            if not line or not line.startswith("data: "):
                continue
            data_str = line[6:]
            if data_str.strip() == "[DONE]":
                break
            try:
                obj = json.loads(data_str)
                delta = obj.get("choices", [{}])[0].get("delta", {})
                content_token = delta.get("content", "")
                if content_token:
                    yield content_token
            except Exception:
                continue

    for token in _clean_stream(raw_chunks()):
        yield {"text": token}



def _restart_06b_model():
    """Kill stale 0.6B process and restart it. Returns True if restarted."""
    import subprocess, os
    model_path = "/home/youyeetoo/rkllm_model_zoo/Qwen3-0.6B/Qwen3-0.6B-Q4_K_M.gguf"
    port = 8088
    log_path = "/tmp/llama-8088.log"
    bin_path = "/home/youyeetoo/llama.cpp-master/build/bin/llama-server"
    try:
        # Kill existing process on port
        subprocess.run(["fuser", "-k", f"{port}/tcp"], capture_output=True, timeout=5)
        import time
        time.sleep(2)
        # Start new llama-server
        subprocess.Popen(
            [bin_path, "-m", model_path, "--host", "0.0.0.0", "--port", str(port),
             "-c", "6144", "--threads", "4", "--jinja", "--reasoning", "off"],
            stdout=open(log_path, "w"), stderr=subprocess.STDOUT,
            preexec_fn=os.setpgrp,
        )
        # Wait for it to be ready (up to 15s)
        deadline = time.time() + 15
        while time.time() < deadline:
            time.sleep(1)
            try:
                s = __import__("socket").socket()
                s.settimeout(1)
                s.connect(("127.0.0.1", port))
                s.close()
                return True
            except Exception:
                continue
        return False
    except Exception:
        return False

def _local_small_generate(prompt: str, max_tokens: Optional[int] = None) -> dict:
    """Call local 0.6B with bare prompt only (no system prompt, no history)."""
    url = str(_setting("local_small_model_api_url", "")).strip()
    if not url:
        return {"error": "local small model not configured"}
    model = str(_setting("local_small_model_name", "Qwen3-0.6B-Q4_K_M.gguf"))
    timeout = float(_setting("prompt_timeout_seconds", 12))
    max_t = min(int(max_tokens or 256), 512)
    safe_prompt = (prompt or "").strip()[:1500]
    if not safe_prompt:
        return {"error": "empty prompt"}
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": safe_prompt}],
        "max_tokens": max_t,
        "temperature": 0.3,
        "stream": False,
    }
    # Try up to 3 times (cold start, concurrent queue, transient errors)
    import time as _time
    last_error = None
    for attempt in range(3):
        try:
            resp = requests.post(url, json=payload, timeout=timeout)
            if resp.status_code == 200:
                text = resp.json().get("choices", [{}])[0].get("message", {}).get("content", "")
                if text:
                    return {"text": _clean_model_text(text), "source": "local-fallback"}
                last_error = "empty response"
            elif resp.status_code == 503:
                # Model busy (concurrent request), wait and retry
                last_error = "Local small model busy (503)"
                _time.sleep(5)
            else:
                last_error = "Local small model HTTP %d" % resp.status_code
                _time.sleep(2)
        except requests.exceptions.Timeout:
            last_error = "Local small model timeout (attempt %d)" % (attempt + 1)
            # Longer wait on timeout (model may be cold-starting)
            _time.sleep(5)
        except requests.exceptions.ConnectionError:
            last_error = "Local small model unreachable"
            # Try restarting 0.6B
            try:
                _restart_06b_model()
                _time.sleep(5)
            except Exception:
                pass
        except Exception as e:
            last_error = str(e)
            _time.sleep(2)
    return {"error": last_error or "Local small model failed after 3 attempts"}

# ============================================================
# Cloud DashScope API (保留供参考，降级链已不再使用)
# ============================================================

def _cloud_settings(max_tokens: Optional[int] = None):
    key = str(_setting("cloud_api_key", ""))
    url = str(_setting("cloud_base_url", "https://dashscope.aliyuncs.com/compatible-mode")).rstrip("/")
    model = str(_setting("cloud_model", "qwen-plus"))
    timeout = float(_setting("cloud_timeout_seconds", 60))
    max_t = int(max_tokens or _setting("ollama_max_tokens", 4096))
    temp = float(_setting("ollama_temperature", 0.2))
    return key, url, model, timeout, max_t, temp


def _cloud_headers(api_key: str) -> dict:
    return {"Authorization": "Bearer " + api_key, "Content-Type": "application/json"}


def _cloud_messages(prompt: str) -> list:
    return [{"role": "user", "content": prompt}]


def _cloud_generate(prompt: str, max_tokens: Optional[int] = None) -> dict:
    key, url, model, timeout, max_t, temp = _cloud_settings(max_tokens)
    if not key:
        return {"error": "cloud_api_key not configured"}
    payload = {
        "model": model,
        "messages": _cloud_messages(prompt),
        "max_tokens": max_t,
        "temperature": temp,
        "stream": False,
    }
    resp = requests.post(url + "/v1/chat/completions", json=payload,
                         headers=_cloud_headers(key), timeout=timeout)
    if resp.status_code != 200:
        return {"error": "Cloud API HTTP %d: %s" % (resp.status_code, resp.text[:200])}
    data = resp.json()
    text = data.get("choices", [{}])[0].get("message", {}).get("content", "")
    return {"text": _clean_model_text(text), "source": "cloud"}


def _cloud_generate_stream(prompt: str, max_tokens: Optional[int] = None):
    key, url, model, timeout, max_t, temp = _cloud_settings(max_tokens)
    if not key:
        yield {"error": "cloud_api_key not configured"}
        return
    payload = {
        "model": model,
        "messages": _cloud_messages(prompt),
        "max_tokens": max_t,
        "temperature": temp,
        "stream": True,
    }
    try:
        resp = requests.post(url + "/v1/chat/completions", json=payload,
                             headers=_cloud_headers(key), stream=True, timeout=timeout)
        if resp.status_code != 200:
            yield {"error": "Cloud API HTTP %d: %s" % (resp.status_code, resp.text[:200])}
            return
        for line in resp.iter_lines(decode_unicode=True):
            if not line or not line.startswith("data: "):
                continue
            data_str = line[6:]
            if data_str.strip() == "[DONE]":
                break
            try:
                obj = json.loads(data_str)
                delta = obj.get("choices", [{}])[0].get("delta", {})
                content = delta.get("content", "")
                if content:
                    yield {"text": content}
            except Exception:
                continue
    except Exception as e:
        yield {"error": str(e)}


def _ollama_generate_with_fallback(prompt: str, max_tokens: Optional[int] = None) -> dict:
    try:
        result = _ollama_generate(prompt, max_tokens=max_tokens)
    except requests.exceptions.ConnectionError:
        result = {"error": "Model unreachable"}
    except Exception as e:
        result = {"error": str(e)}
    if "error" in result:
        # Retry 35B 3-5 times before degrading
        retry_count = 0
        max_retries = 4
        retry_result = result
        while retry_count < max_retries and "error" in retry_result:
            retry_count += 1
            import time as _time
            _time.sleep(1.5)
            try:
                retry_result = _ollama_generate(prompt, max_tokens=max_tokens)
            except Exception:
                retry_result = {"error": "retry failed"}
        if "error" not in retry_result:
            return retry_result
        # All retries exhausted → degrade to 0.6B
        local = _local_small_generate(_extract_user_content(prompt), max_tokens=max_tokens)
        if "error" not in local:
            return local
    return result


def _ollama_generate_direct_with_fallback(prompt: str, max_tokens: Optional[int] = None) -> dict:
    try:
        result = _ollama_generate_direct(prompt, max_tokens=max_tokens)
    except requests.exceptions.ConnectionError:
        result = {"error": "Model unreachable"}
    except Exception as e:
        result = {"error": str(e)}
    if "error" in result:
        retry_count = 0
        max_retries = 4
        retry_result = result
        while retry_count < max_retries and "error" in retry_result:
            retry_count += 1
            import time as _time
            _time.sleep(1.5)
            try:
                retry_result = _ollama_generate_direct(prompt, max_tokens=max_tokens)
            except Exception:
                retry_result = {"error": "retry failed"}
        if "error" not in retry_result:
            return retry_result
        local = _local_small_generate(prompt, max_tokens=max_tokens)
        if "error" not in local:
            return local
    return result


def _ollama_generate_stream_with_fallback(prompt: str, max_tokens: Optional[int] = None):
    had_error = False
    try:
        for item in _ollama_generate_stream(prompt, max_tokens=max_tokens):
            if item.get("error"):
                had_error = True
                break
            yield item
    except requests.exceptions.ConnectionError:
        had_error = True
    except Exception:
        had_error = True
    if had_error:
        # Retry 3-5 times
        retry_count = 0
        retry_success = False
        while retry_count < 4 and not retry_success:
            retry_count += 1
            import time as _time
            _time.sleep(1.5)
            try:
                for item in _ollama_generate_stream(prompt, max_tokens=max_tokens):
                    if item.get("error"):
                        break
                    yield item
                    retry_success = True
            except Exception:
                continue
        if not retry_success:
            local = _local_small_generate(_extract_user_content(prompt), max_tokens=max_tokens)
            if "error" not in local:
                yield {"text": local.get("text", "")}


def _ollama_generate_direct_stream_with_fallback(prompt: str, max_tokens: Optional[int] = None):
    had_error = False
    try:
        for item in _ollama_generate_direct_stream(prompt, max_tokens=max_tokens):
            if item.get("error"):
                had_error = True
                break
            yield item
    except requests.exceptions.ConnectionError:
        had_error = True
    except Exception:
        had_error = True
    if had_error:
        retry_count = 0
        retry_success = False
        while retry_count < 4 and not retry_success:
            retry_count += 1
            import time as _time
            _time.sleep(1.5)
            try:
                for item in _ollama_generate_direct_stream(prompt, max_tokens=max_tokens):
                    if item.get("error"):
                        break
                    yield item
                    retry_success = True
            except Exception:
                continue
        if not retry_success:
            local = _local_small_generate(prompt, max_tokens=max_tokens)
            if "error" not in local:
                yield {"text": local.get("text", "")}


def generate(prompt: str, max_tokens: int = 4096) -> dict:
    user_content = _extract_user_content(prompt)
    if not user_content:
        return {"error": "prompt is required"}
    exam_answer = _exam_direct_answer(user_content)
    if exam_answer:
        return {"text": exam_answer}
    local = _local_reply(user_content)
    if local:
        return {"text": local}
    creative_short = _creative_short_fallback(user_content)
    if creative_short:
        return {"text": creative_short}
    fallback = _general_short_fallback(user_content, prompt)
    story_fallback = _story_continuation_fallback(user_content, prompt)
    if story_fallback:
        return {"text": story_fallback}
    if fallback and not _has_conversation_history(prompt):
        return {"text": fallback}
    refined_prompt = refine_prompt(user_content)
    try:
        model_prompt = prompt if _has_conversation_history(prompt) else refined_prompt
        result = _ollama_generate_with_fallback(model_prompt, max_tokens=max_tokens)
        if "error" not in result:
            result["text"] = _guarded_answer(user_content, _clean_model_text(result.get("text", "")), "", max_tokens=max_tokens)
            if not (result.get("text") or "").strip():
                result["text"] = story_fallback or creative_short or fallback or ""
        return result
    except requests.exceptions.ConnectionError:
        return {"error": "Model server not reachable at %s" % _setting("ollama_base_url", DEFAULT_OLLAMA_URL)}
    except requests.exceptions.Timeout:
        return {"error": "Model request timed out"}
    except Exception as exc:
        return {"error": str(exc)}


def generate_with_context(question: str, context: str, max_tokens: int = 6144) -> dict:
    if not (question or "").strip():
        return {"error": "prompt is required"}
    if not (context or "").strip():
        return generate("User: " + question + "\nAssistant:", max_tokens=max_tokens)
    exam_answer = _exam_direct_answer(question, context)
    if exam_answer:
        return {"text": exam_answer}
    literal = _literal_field_answer(question, context)
    if literal:
        return {"text": literal}
    relation = _image_text_relation_answer(question, context)
    if relation:
        return {"text": relation}
    summary = _context_summary_answer(question, context)
    if summary:
        return {"text": summary}
    advice = _context_advice_answer(question, context)
    if advice:
        return {"text": advice}
    try:
        result = _ollama_generate_direct_with_fallback(_build_qwen_context_prompt(question, context), max_tokens=max_tokens)
        if "error" not in result and _looks_like_placeholder_or_error(result.get("text", "")):
            return {"text": advice or _fallback_context_answer(question, context)}
        if "error" not in result:
            result["text"] = _guarded_answer(question, result.get("text", ""), context, max_tokens=max_tokens)
            result["text"] = ensure_context_answer(question, context, result.get("text", ""), max_tokens=max_tokens)
        return result
    except requests.exceptions.ConnectionError:
        return {"error": "Model server not reachable at %s" % _setting("ollama_base_url", DEFAULT_OLLAMA_URL)}
    except requests.exceptions.Timeout:
        return {"error": "Model request timed out"}
    except Exception as exc:
        return {"error": str(exc)}


def generate_stream(prompt: str, max_tokens: int = 4096):
    user_content = _extract_user_content(prompt)
    if not user_content:
        yield _sse_data({"error": "prompt is required"})
        return
    exam_answer = _exam_direct_answer(user_content)
    if exam_answer:
        yield from _yield_paced_sse_text(exam_answer)
        yield "data: [DONE]\n\n"
        return
    local = _local_reply(user_content)
    if local:
        yield from _yield_paced_sse_text(local)
        yield "data: [DONE]\n\n"
        return
    creative_short = _creative_short_fallback(user_content)
    if creative_short:
        yield from _yield_paced_sse_text(creative_short)
        yield "data: [DONE]\n\n"
        return
    fallback = _general_short_fallback(user_content, prompt)
    story_fallback = _story_continuation_fallback(user_content, prompt)
    if story_fallback:
        yield from _yield_paced_sse_text(story_fallback)
        yield "data: [DONE]\n\n"
        return
    if fallback and not _has_conversation_history(prompt):
        yield from _yield_paced_sse_text(fallback)
        yield "data: [DONE]\n\n"
        return
    refined_prompt = refine_prompt(user_content)
    try:
        model_prompt = prompt if _has_conversation_history(prompt) else refined_prompt
        yield from _stream_ollama_sse(
            lambda: _ollama_generate_stream_with_fallback(model_prompt, max_tokens=max_tokens),
            user_content,
            max_tokens=max_tokens,
            fallback_text=story_fallback or creative_short or fallback or "",
        )
    except Exception as exc:
        yield _sse_data({"error": str(exc)})
    yield "data: [DONE]\n\n"


def generate_stream_with_context(question: str, context: str, max_tokens: int = 6144):
    if not (question or "").strip():
        yield _sse_data({"error": "prompt is required"})
        return
    if not (context or "").strip():
        yield from generate_stream("User: " + question + "\nAssistant:", max_tokens=max_tokens)
        return
    exam_answer = _exam_direct_answer(question, context)
    if exam_answer:
        yield from _yield_paced_sse_text(exam_answer)
        yield "data: [DONE]\n\n"
        return
    literal = _literal_field_answer(question, context)
    if literal:
        yield _sse_data({"text": literal})
        yield "data: [DONE]\n\n"
        return
    relation = _image_text_relation_answer(question, context)
    if relation:
        yield _sse_data({"text": relation})
        yield "data: [DONE]\n\n"
        return
    summary = _context_summary_answer(question, context)
    if summary:
        yield _sse_data({"text": summary})
        yield "data: [DONE]\n\n"
        return
    advice = _context_advice_answer(question, context)
    if advice:
        yield _sse_data({"text": advice})
        yield "data: [DONE]\n\n"
        return
    try:
        prompt = _build_qwen_context_prompt(question, context)
        yield from _stream_ollama_sse(
            lambda: _ollama_generate_direct_stream_with_fallback(prompt, max_tokens=max_tokens),
            question,
            context=context,
            max_tokens=max_tokens,
            fallback_text=advice or _fallback_context_answer(question, context),
        )
    except Exception as exc:
        yield _sse_data({"error": str(exc)})
    yield "data: [DONE]\n\n"
