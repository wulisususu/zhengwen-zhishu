    attachment_context: str = "",
    conversation_id: int | None = None,
    user_id: int | None = None,
    attachment_ids: list[int] | None = None,
    audio_attachment_ids: list[int] | None = None,
    preflight: dict[str, Any] | None = None,
) -> str:
    attachment_ids = _normalize_int_list(attachment_ids)
    audio_attachment_ids = _normalize_int_list(audio_attachment_ids)
    lines = [
        "你是一个自然、稳妥、会承接上下文的中文助手。",
        "优先直接帮助用户推进，不要输出思考过程。",
        "工具调用规则：",
        "1. 如果用户明确要求朗读、播报、生成语音、播放语音或 TTS，必须调用 synthesize_speech，不要只口头说明会去处理。",
        "2. synthesize_speech 的 text 参数必须是准备播报给用户的最终中文内容，不要输出 audio_bytes=... 之类的调试文本。",
        "3. 如果用户要求转写、识别、听写当前已上传音频，且当前存在可用音频附件 file_id，必须调用 transcribe_audio，不要直接伪造转写结果。",
        "4. 调用 transcribe_audio 时，必须原样带上 conversation_id、user_id 和其中一个 file_id；如果有多个音频 file_id，优先使用列表最后一个。",
        "5. 如果没有可用音频附件，就不要调用 transcribe_audio，改为明确提示用户先上传音频。",
        "6. 如果不是明确的语音生成或音频转写请求，就直接正常回答，不要为了展示工具而调用工具。",
        "7. 工具调用失败时，不要伪造完成状态，先回到上一步修正后再继续。",
        "",
    ]
    if conversation_id:
        lines.append(f"当前 conversation_id={int(conversation_id)}。")
    if user_id:
        lines.append(f"当前 user_id={int(user_id)}。")
    if attachment_ids:
        lines.append(f"当前消息可用附件 file_id 列表：{attachment_ids}。")
    if audio_attachment_ids:
        lines.append(f"当前消息可用于 ASR 的音频 file_id 列表：{audio_attachment_ids}。")
    else:
        lines.append("当前消息没有可用于 ASR 的音频附件 file_id。")
    if _is_explicit_tts_request(content):
        lines.extend([
            "当前用户消息是一次明确的 TTS 请求。",
            "你本轮必须调用 synthesize_speech，不允许只给文字解释。",
            "不要输出音标、拼读、发音解释、释义，或询问用户是否还要生成音频。",
            "如果用户在冒号、引号或书名号后给了要朗读的正文，synthesize_speech.text 应直接使用那段正文；否则就朗读用户明确指定的正文。",
        ])
    if _is_explicit_asr_request(content) and audio_attachment_ids:
        lines.extend([
            "当前用户消息是一次明确的 ASR 请求。",
            "你本轮必须调用 transcribe_audio，不允许直接凭空写出转写结果。",
            "优先使用当前音频 file_id 列表中的最后一个 file_id 作为本轮转写目标。",
            "不要把转写任务改写成摘要、翻译或解释，先完成逐字转写。",
        ])
    if preflight:
        summary = str(preflight.get("summary") or "").strip()
        refined_prompt = str(preflight.get("refined_prompt") or "").strip()
        lines.extend([
            "",
            "Chat preflight：",
            "原始用户输入优先级最高；小模型整理结果只作为辅助理解，不能覆盖或替代原始用户输入。",
        ])
        if summary:
            lines.append(f"小模型任务理解：{summary[:600]}")
        if refined_prompt:
            lines.append(f"小模型整理后的提示：{refined_prompt[:1200]}")
