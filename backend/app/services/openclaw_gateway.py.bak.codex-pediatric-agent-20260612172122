        return None
    try:
        rows = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except Exception:
        return None

    known_call_ids = known_call_ids or set()
    allowed_statuses = allowed_statuses or {"validated", "completed"}
    for raw in reversed(rows):
        try:
            payload = json.loads(raw)
        except Exception:
            continue
        if not isinstance(payload, dict):
            continue
        if str(payload.get("tool_name") or "").strip() != tool_name:
            continue
        if str(payload.get("status") or "").strip() not in allowed_statuses:
            continue
        call_id = str(payload.get("call_id") or "").strip()
        if call_id and call_id in known_call_ids:
            continue
        result_snapshot = payload.get("result_snapshot") or {}
        if not isinstance(result_snapshot, dict):
            continue
        return {
            "call_id": call_id,
            "status": str(payload.get("status") or "").strip(),
            "result_snapshot": result_snapshot,
            "input_snapshot": payload.get("input_snapshot") or {},
