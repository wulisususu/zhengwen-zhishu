def _document_provider_failure_text(payload: Any) -> str:
    if not isinstance(payload, dict):
        return ""
    status = str(payload.get("status") or "").strip().lower()
    error_payload = payload.get("error") if isinstance(payload.get("error"), dict) else {}
    error_message = str((error_payload or {}).get("message") or "").strip()
    error_code = str((error_payload or {}).get("code") or "").strip()
    if status != "failed" and not error_message:
        return ""
    lowered = error_message.lower()
    if "timeout" in lowered:
        return "中科信创自研模型上游模型超时，本次没有创建文档任务。请稍后重试，或先缩短文档篇幅后再生成。"
    if error_message:
        return f"中科信创自研模型文档生成失败：{error_message}"
    if error_code:
        return f"中科信创自研模型文档生成失败：{error_code}"
    return "中科信创自研模型文档生成失败，本次没有创建文档任务。"


def extract_kb_grounding_payload(payload: Any) -> dict[str, Any] | None:
    matches: list[dict[str, Any]] = []

    def normalize_sources(raw_sources: Any) -> list[dict[str, Any]]:
        if not isinstance(raw_sources, list):
            return []
        normalized: list[dict[str, Any]] = []
        for item in raw_sources:
            if not isinstance(item, dict):
                continue
            normalized.append({
                "chunk_id": item.get("chunk_id"),
                "filename": item.get("filename"),
                "score": item.get("score"),
                "chunk_text": item.get("chunk_text"),
            })
        return normalized

    def walk(node: Any, kb_context: bool = False) -> None:
        current_kb_context = kb_context
        if isinstance(node, dict):
            name = str(node.get("name") or "").strip()
            if name == "kb_search":
                current_kb_context = True
            passages = node.get("passages")
            sources = node.get("sources")
            if current_kb_context and isinstance(passages, list) and isinstance(sources, list):
                normalized_sources = normalize_sources(sources)
                matches.append({
                    "grounded": bool(normalized_sources),
                    "source_count": len(normalized_sources),
                    "sources": normalized_sources,
                    "passages": passages,
                })
            for value in node.values():
                walk(value, current_kb_context)
        elif isinstance(node, list):
            for item in node:
                walk(item, current_kb_context)

    walk(payload)
    return matches[0] if matches else None


def extract_kb_grounding_from_trace_rows(
    rows: list[str],
    known_call_ids: set[str] | None = None,
) -> dict[str, Any] | None:
    known_call_ids = known_call_ids or set()
    for raw in reversed(rows):
        try:
            payload = json.loads(raw)
        except Exception:
            continue
        if not isinstance(payload, dict):
            continue
        if str(payload.get("tool_name") or "").strip() != "kb_search":
            continue
        if str(payload.get("status") or "").strip() not in {"validated", "completed"}:
            continue
        call_id = str(payload.get("call_id") or "").strip()
        if call_id and call_id in known_call_ids:
            continue
        result_snapshot = payload.get("result_snapshot") or {}
        if not isinstance(result_snapshot, dict):
            continue
        sources = result_snapshot.get("sources")
        passages = result_snapshot.get("passages")
        if not isinstance(sources, list) or not isinstance(passages, list):
            continue
        normalized_sources = []
        for item in sources:
            if not isinstance(item, dict):
                continue
            normalized_sources.append({
                "chunk_id": item.get("chunk_id"),
                "filename": item.get("filename"),
                "score": item.get("score"),
                "chunk_text": item.get("chunk_text"),
            })
        return {
            "call_id": call_id,
            "grounded": bool(normalized_sources),
            "source_count": len(normalized_sources),
            "sources": normalized_sources,
            "passages": passages,
        }
    return None


def load_tool_trace_call_ids(tool_name: str, trace_dir: str = "") -> set[str]:
    path = _resolve_tool_trace_path(tool_name, trace_dir)
    if not path.exists():
        return set()
    call_ids: set[str] = set()
    try:
        for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                payload = json.loads(raw)
            except Exception:
                continue
            if not isinstance(payload, dict):
                continue
            call_id = str(payload.get("call_id") or "").strip()
            if call_id:
                call_ids.add(call_id)
    except Exception:
        return set()
    return call_ids


def load_latest_tool_trace_result(
    tool_name: str,
    *,
    known_call_ids: set[str] | None = None,
    trace_dir: str = "",
    allowed_statuses: set[str] | None = None,
) -> dict[str, Any] | None:
