def _resolve_tool_trace_path(tool_name: str, trace_dir: str = "") -> Path:
    candidates: list[Path] = []
    configured = trace_dir.strip() or os.getenv("OPENCLAW_TOOL_TRACE_DIR") or ""
    if configured:
        candidates.append(Path(configured))
    candidates.append(Path(".openclaw/state/runtime"))
    candidates.append(Path.home() / ".openclaw/state/runtime")
    for base in candidates:
        path = base / f"{tool_name}.jsonl"
        if path.exists():
