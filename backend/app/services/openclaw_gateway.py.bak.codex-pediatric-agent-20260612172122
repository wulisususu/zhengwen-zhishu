def find_document_render_tail_index(text: str) -> int:
    source = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
    matches: list[int] = []
    for pattern in _DOCUMENT_TAIL_PATTERNS:
        match = re.search(pattern, source, flags=re.IGNORECASE)
        if match:
            matches.append(match.start())
    return min(matches) if matches else -1


def merge_openclaw_text_delta(current: str, delta: str) -> str:
    base = str(current or "")
    incoming = str(delta or "")
    if not incoming:
        return base
    if not base:
        return incoming
    if incoming == base:
        return base
    if incoming.startswith(base):
        return incoming
    if len(incoming) >= 80 and incoming in base:
        return base
    max_overlap = min(len(base), len(incoming))
    for size in range(max_overlap, 0, -1):
        if base.endswith(incoming[:size]):
            return base + incoming[size:]
    return base + incoming


def _is_openclaw_empty_placeholder(text: str) -> bool:
    return str(text or "").strip() == "No response from OpenClaw."


def _remove_openclaw_empty_placeholder(text: str) -> str:
    source = str(text or "")
    source = re.sub(
        r"(?m)^\s*No response from OpenClaw\.\s*$\n?",
        "",
        source,
    )
    return source


def _remove_document_section_complete_markers(text: str) -> str:
    return re.sub(r"<!--\s*SECTION_COMPLETE\s*:\s*[^>]*-->", "", str(text or ""))


def _strip_document_tail(text: str) -> str:
    source = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
    index = find_document_render_tail_index(source)
    if index >= 0:
        source = source[:index]
    return source


def _strip_full_document_code_fence(text: str) -> str:
    source = str(text or "").strip()
    if not source.startswith("```"):
        return str(text or "")
    match = re.fullmatch(r"```(?:markdown|md|text)?\s*\n([\s\S]*?)\n```\s*", source, flags=re.IGNORECASE)
    if match:
        body = match.group(1).strip()
        return body if body else str(text or "")
    body = re.sub(r"^```(?:markdown|md|text)?\s*\n?", "", source, flags=re.IGNORECASE).strip()
    body = re.sub(r"\n?```\s*$", "", body).strip()
    return body if body else str(text or "")


def _drop_footer_metadata_lines(text: str) -> str:
    kept: list[str] = []
    for line in str(text or "").split("\n"):
        stripped = line.strip()
        normalized = re.sub(r"\s+", "", stripped)
        if not stripped:
            kept.append(line.rstrip())
            continue
        if re.match(r"^```(?:markdown|md|text)?\s*$", stripped, flags=re.IGNORECASE):
            continue
        if stripped in {"现在", "现在我", "现在我将", "接下来", "接下来我", "下面", "下面我"}:
            continue
        metadata_line = re.sub(r"\*+", "", stripped).strip()
        if re.match(r"^(报告生成|报告编制人?|报告编号|编制人|审核人|审核|批准人?|审批人|分发范围|编制日期|报告日期|数据源|数据周期|联系方式)\s*[:：]", metadata_line):
            continue
        if re.match(r"^(报告生成|报告编制人?|报告编号|编制人|审核人|审核|批准人?|审批人|分发范围|编制日期|报告日期|数据源|数据周期|联系方式)\s*[:：]", stripped.replace("**", "")):
            continue
        if re.match(r"^(现在我将|现在调用|我将调用|接下来调用).*(文档渲染|DOCX|document_render_docx|工具)", stripped, flags=re.IGNORECASE):
            continue
        if re.search(r"(文档任务已提交|文档任务已创建|让我查询任务状态|查询任务状态|正在处理中)", stripped):
            continue
        status_line = stripped.replace("**", "")
        if re.search(r"(任务已完成|\bstatus\s*:\s*done\b|\btitle\s*:|任务\s*ID\s*[:：]|状态\s*[:：]\s*done|标题\s*[:：]|下载链接\s*[:：])", status_line, flags=re.IGNORECASE):
            continue
        if re.match(r"^\|\s*(项目|字段)\s*\|\s*值\s*\|", stripped):
            continue
        if re.match(r"^\|\s*[-:]+\s*\|\s*[-:]+\s*\|", stripped):
            continue
        if normalized in {"项目值", "字段值"}:
            continue
        if re.search(r"(task_id|download_url|MEDIA:document_render_docx|document_render_docx)", stripped, flags=re.IGNORECASE):
            continue
        if "OpenClaw 文档 Agent" in stripped or "OpenClaw 文档生成系统" in stripped:
            continue
        if "operations@company.com" in stripped:
            continue
        kept.append(line.rstrip())
    return "\n".join(kept)


def compact_document_filename(instruction: str = "", markdown: str = "", *, max_chars: int = 10) -> str:
    source = f"{instruction or ''}\n{markdown or ''}"
    candidates = [
        (r"运维手册|部署手册|使用手册|操作手册", "运维手册"),
        (r"运维|监控巡检|备份恢复", "运维服务"),
        (r"事故|网络中断|故障调查|事故调查|整改措施", "事故调查报告"),
        (r"一卡通|公交支付|校园支付|停车管理|电子钱包", "一卡通投标文件"),
        (r"投标|标书|招标", "投标技术文件"),
        (r"月度运营|运营分析", "月度运营报告"),
        (r"周报", "项目周报"),
        (r"日报", "工作日报"),
        (r"实施方案|部署方案", "实施方案"),
        (r"技术方案", "技术方案"),
        (r"安全设计", "安全设计"),
        (r"售后", "运维服务"),
    ]
    for pattern, title in candidates:
        if re.search(pattern, source):
            return title[:max_chars]
    heading = re.search(r"(?m)^#\s+(.+?)\s*$", str(markdown or ""))
    value = heading.group(1) if heading else str(instruction or "文档").strip()
    value = re.sub(r"[《》“”\"'（）()\[\]【】]", "", value)
    value = re.sub(r"^(请|帮我|根据以下数据|编写|撰写|生成|输出|制作|一份)+", "", value)
    value = re.sub(r"(技术部分|正式文档|Word文档|word文档|文档)$", "", value, flags=re.IGNORECASE)
    value = re.sub(r"[^0-9A-Za-z\u4e00-\u9fff]+", "", value)
    return (value or "文档")[:max_chars]


