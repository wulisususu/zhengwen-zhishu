def extract_response_text(payload: Any) -> str:
    found: list[str] = []

    def add(text: Any) -> None:
        if not isinstance(text, str):
            return
        value = text.strip()
        if _is_openclaw_empty_placeholder(value):
            return
        if value and value not in found:
            found.append(value)

    def walk(node: Any) -> None:
        if isinstance(node, dict):
            node_type = str(node.get("type") or "").strip().lower()
            if isinstance(node.get("output_text"), str):
                add(node.get("output_text"))
            if node_type in {"output_text", "text"} and isinstance(node.get("text"), str):
                add(node.get("text"))
            if isinstance(node.get("content"), str):
                add(node.get("content"))
            if isinstance(node.get("message"), str):
                add(node.get("message"))
            for value in node.values():
                walk(value)
        elif isinstance(node, list):
            for item in node:
                walk(item)

    walk(payload)
    return "\n".join(found).strip()


def parse_openclaw_sse_event(raw_line: str, pending_event: str = "") -> tuple[str, dict[str, Any] | None]:
    line = (raw_line or "").strip()
    if not line:
        return pending_event, None
    if line.startswith("event: "):
        return line[7:].strip(), None
    if not line.startswith("data: "):
        return pending_event, None
    data = line[6:].strip()
    if data == "[DONE]":
        return pending_event, {"type": "[DONE]"}
    try:
        payload = json.loads(data)
    except Exception:
        return pending_event, None
    event_type = str(payload.get("type") or pending_event or "").strip()
    return pending_event, {"event": event_type, "payload": payload}


def extract_openclaw_stream_delta(payload: Any) -> str:
    if not isinstance(payload, dict):
        return ""
    payload_type = str(payload.get("type") or "").strip()
    if payload_type == "response.output_text.delta":
        return str(payload.get("delta") or "")
    if payload_type == "response.output_text.done":
        return str(payload.get("text") or "")
    if payload_type in {"response.output_item.done", "response.completed"}:
        return extract_response_text(payload)
    if payload_type == "response.output_item.added":
        return extract_response_text(payload)
    return ""


def extract_openclaw_completed_text(payload: Any) -> str:
    if not isinstance(payload, dict):
        return ""
    if str(payload.get("type") or "").strip() != "response.completed":
        return ""
    response = payload.get("response")
    return extract_response_text(response) if response is not None else ""


def collect_openclaw_done_flag(events: list[dict[str, Any]] | None) -> bool:
    for item in events or []:
        payload = (item or {}).get("payload") or {}
        if str(payload.get("type") or "").strip() == "response.completed":
            return True
    return False


def collect_openclaw_text_fragments(events: list[dict[str, Any]] | None) -> str:
    collected: list[str] = []
    seen: set[str] = set()
    for item in events or []:
        payload = (item or {}).get("payload") or {}
        text = (
            extract_openclaw_stream_delta(payload)
            if str(payload.get("type") or "").strip() != "response.completed"
            else extract_openclaw_completed_text(payload)
        )
        value = str(text or "").strip()
        if not value or value in seen:
            continue
        seen.add(value)
        collected.append(value)
    if not collected:
        return ""
    final_text = collected[-1]
    if len(collected) > 1 and final_text == "".join(collected[:-1]):
        return final_text
    return "".join(collected)


def normalize_grounding_payload(payload: dict[str, Any] | None) -> dict[str, Any]:
    payload = payload or {}
    raw_sources = payload.get("sources")
    normalized_sources: list[dict[str, Any]] = []
    if isinstance(raw_sources, list):
        for item in raw_sources:
            if not isinstance(item, dict):
                continue
            normalized_sources.append({
                "chunk_id": item.get("chunk_id"),
                "filename": item.get("filename"),
                "score": item.get("score"),
                "chunk_text": item.get("chunk_text"),
            })
    grounded = bool(payload.get("grounded"))
    source_count = len(normalized_sources)
    if grounded and source_count <= 0:
        grounded = False
    return {
        "grounded": grounded,
        "source_count": source_count,
        "sources": normalized_sources,
    }


def synthesize_document_reply(task: dict[str, Any] | None, response_text: str) -> str:
    text = (response_text or "").strip()
    if task:
        lowered = text.lower()
        queue_receipt_markers = [
            "task id",
            "状态: 已加入队列",
            "文档生成任务已提交",
            '"object":"response"',
            '"model":"openclaw/docgen"',
        ]
        if (not text) or any(marker in lowered for marker in queue_receipt_markers):
            return "中科信创自研模型已受理文档生成任务，正在后台生成，请稍候查看结果。"
        if text:
            return text
        return "中科信创自研模型已受理文档生成任务，正在后台生成，请稍候查看结果。"
    repair = (
        "中科信创自研模型这一步没有产出有效的文档任务。"
        "请回到上一步检查 tool 参数、conversation_id、user_id、Gateway token 和 provider 的 tool calling 后再重试。"
    )
    return f"{text}\n\n{repair}".strip() if text else repair


def finalize_document_outcome(task: dict[str, Any] | None, response_text: str, timed_out: bool = False) -> dict[str, Any]:
    normalized_task = validate_document_task_payload(task)
    if normalized_task:
        return {
            "task_detected": True,
            "task": normalized_task,
            "reply_text": synthesize_document_reply(normalized_task, response_text),
            "status": "task_detected",
            "timed_out": bool(timed_out),
        }
    if timed_out:
        reply_text = (
            "中科信创自研模型在当前等待窗口内没有产出可校验的文档任务。"
            "请回到上一步检查 tool 参数、conversation_id、user_id、Gateway token 和 provider 的 tool calling 后再重试。"
        )
        if response_text.strip():
            reply_text = f"{response_text.strip()}\n\n{reply_text}"
        return {
            "task_detected": False,
            "task": None,
            "reply_text": reply_text,
            "status": "timeout_without_task",
            "timed_out": True,
        }
    return {
        "task_detected": False,
        "task": None,
        "reply_text": synthesize_document_reply(None, response_text),
        "status": "no_task",
        "timed_out": False,
    }


def stream_openclaw_agent_response(
    model: str,
    agent_id: str,
    input_text: str,
    timeout_seconds: int,
    base_url: str | None = None,
    token: str | None = None,
) -> dict[str, Any]:
    cfg = _openclaw_cfg()
    final_base_url = (base_url or cfg["gateway_base_url"]).rstrip("/")
    final_token = (token or cfg["gateway_token"]).strip()
    headers = {
        "Authorization": f"Bearer {final_token}",
        "Content-Type": "application/json",
    }
    if agent_id:
        headers["x-openclaw-agent-id"] = agent_id
    payload = {
        "model": model,
        "input": input_text,
        "stream": True,
    }
    request_obj = request.Request(
        f"{final_base_url}/v1/responses",
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        headers=headers,
        method="POST",
    )
    content_text = ""
    preview_events: list[dict[str, Any]] = []
    pending_event = ""
    with request.urlopen(request_obj, timeout=timeout_seconds) as resp:
        for raw_line in resp:
            decoded = raw_line.decode("utf-8", errors="replace").rstrip("\r\n")
            pending_event, parsed = parse_openclaw_sse_event(decoded, pending_event)
            if not parsed:
                continue
            if parsed.get("type") == "[DONE]":
                break
            event_type = str(parsed.get("event") or "").strip()
            payload_obj = parsed.get("payload") or {}
            preview_events.append({"event": event_type, "type": payload_obj.get("type"), "payload": payload_obj})
            delta = extract_openclaw_stream_delta(payload_obj)
            if delta:
                content_text += delta
    return {
        "ok": True,
        "text": content_text.strip(),
        "events": preview_events,
    }


def iter_openclaw_agent_events(
    model: str,
    agent_id: str,
    input_text: str,
    timeout_seconds: int,
    base_url: str | None = None,
    token: str | None = None,
):
    cfg = _openclaw_cfg()
    final_base_url = (base_url or cfg["gateway_base_url"]).rstrip("/")
    final_token = (token or cfg["gateway_token"]).strip()
    headers = {
        "Authorization": f"Bearer {final_token}",
        "Content-Type": "application/json",
    }
    if agent_id:
        headers["x-openclaw-agent-id"] = agent_id
    payload = {
        "model": model,
        "input": input_text,
        "stream": True,
    }
    request_obj = request.Request(
        f"{final_base_url}/v1/responses",
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        headers=headers,
        method="POST",
    )
    with request.urlopen(request_obj, timeout=timeout_seconds) as resp:
        pending_event = ""
        for raw_line in resp:
            decoded = raw_line.decode("utf-8", errors="replace").rstrip("\r\n")
            pending_event, parsed = parse_openclaw_sse_event(decoded, pending_event)
            if not parsed:
                continue
            yield parsed
            if parsed.get("type") == "[DONE]":
                break


def invoke_openclaw_tool(
    *,
    name: str,
    args: dict[str, Any],
    agent_id: str = "docgen",
    timeout_seconds: int | None = None,
) -> dict[str, Any]:
    cfg = _openclaw_cfg()
    if not cfg["enabled"] or not cfg["gateway_token"]:
        return {"ok": False, "error": {"message": "OpenClaw gateway is not enabled"}}
    headers = {
        "Authorization": f"Bearer {cfg['gateway_token']}",
        "Content-Type": "application/json",
    }
    body = {
        "name": name,
        "agentId": agent_id,
        "args": args,
    }
    status_code, payload, _raw = _post_json(
        f"{cfg['gateway_base_url']}/tools/invoke",
        headers,
        body,
        timeout_seconds or cfg["timeout_seconds"],
    )
    if status_code >= 400:
        return {"ok": False, "status_code": status_code, **payload}
    return {"ok": True, "status_code": status_code, **payload}


def invoke_backend_document_render_docx(
    args: dict[str, Any],
    *,
    timeout_seconds: int = 60,
) -> dict[str, Any]:
    """Bridge fallback for the same render tool endpoint when plugin auth context is lost."""
    cfg = get_config() if isinstance(get_config(), dict) else {}
    internal = cfg.get("internal", {}) or {}
    token = str(
        os.getenv("BACKEND_INTERNAL_SERVICE_TOKEN")
        or os.getenv("BACKEND_SERVICE_TOKEN")
        or internal.get("service_token")
        or ""
    ).strip()
    if not token:
        return {"ok": False, "status_code": 0, "error": {"message": "internal service token is not configured"}}
    base_url = str(
        os.getenv("BACKEND_BASE_URL")
        or os.getenv("OPENCLAW_BACKEND_BASE_URL")
        or "http://127.0.0.1:8000"
    ).rstrip("/")
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    }
    status_code, payload, _raw = _post_json(
        f"{base_url}/api/v1/internal/document-render-docx",
        headers,
        args,
        timeout_seconds,
    )
    if status_code >= 400:
        return {"ok": False, "status_code": status_code, **payload}
    return {"ok": True, "status_code": status_code, **payload}


def extract_openclaw_tool_result_data(payload: Any) -> dict[str, Any]:
    if not isinstance(payload, dict):
        return {}
    result = payload.get("result")
    if not isinstance(result, dict):
        return {}
    details = result.get("details")
    if not isinstance(details, dict):
        return {}
    data = details.get("data")
    return data if isinstance(data, dict) else {}


def _post_json(url: str, headers: dict[str, str], body: dict[str, Any], timeout_seconds: int) -> tuple[int, dict[str, Any], str]:
    raw_body = json.dumps(body, ensure_ascii=False).encode("utf-8")
    req = request.Request(url, data=raw_body, headers=headers, method="POST")
    try:
        with request.urlopen(req, timeout=timeout_seconds) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            payload = json.loads(raw) if raw.strip() else {}
            return int(getattr(resp, "status", 200) or 200), payload, raw
    except error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        payload = json.loads(raw) if raw.strip().startswith("{") else {}
        return int(exc.code or 500), payload, raw


def call_openclaw_document(
    content: str,
    conversation_id: int,
    user_id: int,
    attachment_ids: list[int] | None = None,
    attachment_context: str = "",
) -> dict[str, Any]:
    cfg = _openclaw_cfg()
    if not cfg["enabled"]:
        return {
            "ok": False,
            "status_code": 0,
            "task": None,
            "response_json": {},
            "assistant_text": "中科信创自研模型文档编排未启用，请先开启 openclaw.enabled 后再重试。",
            "previous_step_hint": "Enable the OpenClaw document adapter in backend/config.yaml before retrying.",
        }
    if not cfg["gateway_token"]:
        return {
            "ok": False,
            "status_code": 0,
            "task": None,
            "response_json": {},
            "assistant_text": "中科信创自研模型 Gateway token 尚未配置，请先补齐授权边界后再重试。",
            "previous_step_hint": "Set openclaw.gateway_token before retrying the document tool loop.",
        }

    payload = {
        "model": cfg["document_model"],
        "input": build_document_input(
            content=content,
            conversation_id=conversation_id,
            user_id=user_id,
            attachment_ids=attachment_ids or [],
            attachment_context=attachment_context,
        ),
        "stream": False,
    }
    headers = {
        "Authorization": f"Bearer {cfg['gateway_token']}",
        "Content-Type": "application/json",
    }
    if cfg["document_agent_id"]:
        headers["x-openclaw-agent-id"] = cfg["document_agent_id"]

    try:
        status_code, response_json, raw_text = _post_json(
            f"{cfg['gateway_base_url']}/v1/responses",
            headers,
            payload,
            cfg["timeout_seconds"],
        )
    except Exception as exc:
        return {
            "ok": False,
            "status_code": 0,
            "task": None,
            "response_json": {},
            "assistant_text": (
                "中科信创自研模型文档编排调用失败。"
                "请回到上一步检查 Gateway 连通性、agent 选择和 provider 配置后再重试。"
            ),
            "previous_step_hint": f"Gateway request exception: {exc}",
        }

    provider_failure_text = _document_provider_failure_text(response_json)
    task = None if provider_failure_text else extract_document_task_payload(response_json)
    response_text = extract_response_text(response_json)
    return {
        "ok": status_code < 400 and not provider_failure_text,
        "status_code": status_code,
        "task": task,
        "response_json": response_json,
        "assistant_text": provider_failure_text or synthesize_document_reply(task, response_text),
        "previous_step_hint": raw_text[:1000],
    }


def submit_openclaw_document(
    content: str,
    conversation_id: int,
    user_id: int,
    attachment_ids: list[int] | None = None,
    attachment_context: str = "",
) -> Future:
    return _executor.submit(
        call_openclaw_document,
        content,
        conversation_id,
        user_id,
        attachment_ids,
        attachment_context,
    )
