def _default_outline_title(content: str) -> str:
    if "运维" in content:
        return "运维手册"
    if "需求规格" in content or "SRS" in content.upper():
        return "软件需求规格说明书"
    if "投标" in content or "标书" in content:
        return "投标技术文件"
    if "事故" in content or "故障" in content:
        return "事故调查报告"
    if "运营" in content:
        return "运营分析报告"
    if "方案" in content:
        return "技术方案"
    return compact_document_filename(content, max_chars=12) or "正式文档"


def build_fallback_document_outline(content: str, *, max_sections: int = 10) -> dict[str, Any]:
    text = str(content or "")
    title = _default_outline_title(text)
    explicit: list[str] = []
    for raw in text.splitlines():
        line = raw.strip(" \t\r\n*-•")
        if not line:
            continue
        line = re.sub(r"^\d+[\.、]\s*", "", line).strip()
        if re.match(r"^第[一二三四五六七八九十\d]+章\s*", line):
            explicit.append(line)
            continue
        if len(line) <= 24 and re.search(r"(概述|需求|架构|设计|方案|部署|实施|测试|运维|保障|接口|数据库|安全|服务)", line):
            explicit.append(line)
    if len(explicit) < 3:
        if "运维" in text:
            explicit = ["系统概述", "运行环境", "部署与发布", "监控巡检", "备份恢复", "故障处理", "安全管理", "应急预案", "运维SOP", "附录"]
        elif "需求规格" in text or "SRS" in text.upper():
            explicit = ["项目概述", "功能需求", "非功能需求", "系统架构", "数据库设计", "接口设计", "部署方案", "测试方案"]
        elif "投标" in text:
            explicit = ["项目理解", "技术方案", "安全设计", "实施方案", "运维服务", "售后保障"]
        else:
            explicit = ["项目概述", "需求分析", "总体方案", "详细设计", "实施计划", "质量保障", "运维支持", "风险控制"]
    sections = []
    seen: set[str] = set()
    for index, name in enumerate(explicit[:max_sections], start=1):
        clean = re.sub(r"^第[一二三四五六七八九十\d]+章\s*", "", name).strip(" ：:")
        if not clean or clean in seen:
            continue
        seen.add(clean)
        sections.append({
            "id": str(len(sections) + 1),
            "title": clean,
            "level": 1,
            "writing_goal": f"围绕“{clean}”展开，结合用户原始需求写成正式文档正文。",
            "children": [],
        })
    return {"title": title, "outline": ensure_outline_covers_requirements(sections, text)[:max_sections]}


def parse_document_outline_response(text: str, *, fallback_content: str = "") -> dict[str, Any]:
    source = str(text or "").strip()
    if source.startswith("```"):
        source = _strip_full_document_code_fence(source)
    candidates = [source]
    match = re.search(r"\{[\s\S]*\}", source)
    if match:
        candidates.insert(0, match.group(0))
    for candidate in candidates:
        try:
            parsed = json.loads(candidate)
        except Exception:
            continue
        if not isinstance(parsed, dict):
            continue
        outline = parsed.get("outline")
        if isinstance(outline, list) and outline:
            title = str(parsed.get("title") or _default_outline_title(fallback_content)).strip()
            return {"title": title, "outline": ensure_outline_covers_requirements(_normalize_document_outline(outline), fallback_content)}
    return build_fallback_document_outline(fallback_content)


def _normalize_document_outline(outline: list[Any]) -> list[dict[str, Any]]:
    normalized: list[dict[str, Any]] = []
    for index, item in enumerate(outline, start=1):
        if isinstance(item, str):
            title = item.strip()
            raw_children: list[Any] = []
            level = 1
            writing_goal = ""
        elif isinstance(item, dict):
            title = str(item.get("title") or item.get("name") or "").strip()
            raw_children = item.get("children") if isinstance(item.get("children"), list) else []
            try:
                level = int(item.get("level") or 1)
            except Exception:
                level = 1
            writing_goal = str(item.get("writing_goal") or item.get("goal") or "").strip()
        else:
            continue
        if not title:
            continue
        section_id = str(item.get("id") if isinstance(item, dict) and item.get("id") else len(normalized) + 1)
        normalized.append({
            "id": section_id,
            "title": title[:80],
            "level": max(1, min(level, 3)),
            "writing_goal": writing_goal[:300] or f"完成“{title}”章节正文。",
            "children": _normalize_document_outline(raw_children) if raw_children else [],
        })
    return normalized


def _document_outline_sections(outline: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [item for item in outline if isinstance(item, dict) and str(item.get("id") or "").strip()]


def ensure_outline_covers_requirements(outline: list[Any], content: str) -> list[dict[str, Any]]:
    """Append explicit user-requested modules that the model outline missed."""
    normalized = _normalize_document_outline(outline)
    text = str(content or "")
    required_candidates = [
        "统一身份认证",
        "身份认证",
        "权限管理",
        "数据加密",
        "日志审计",
        "漏洞管理",
        "灾备方案",
        "备份恢复",
        "公交支付",
        "校园支付",
        "停车管理",
        "电子钱包",
        "项目概述",
        "功能需求",
        "非功能需求",
        "系统架构",
        "数据库设计",
        "接口设计",
        "部署方案",
        "测试方案",
        "安全设计",
        "实施方案",
        "运维服务",
        "售后保障",
    ]
    required: list[str] = []
    for name in required_candidates:
        if name in text and not any(name in existing for existing in required):
            required.append(name)

    def matches_existing(name: str) -> bool:
        for section in normalized:
            title = str(section.get("title") or "")
            if name in title or title in name:
                return True
        return False

    for name in required:
        if matches_existing(name):
            continue
        normalized.append({
            "id": str(len(normalized) + 1),
            "title": name,
            "level": 1,
            "writing_goal": f"围绕用户明确要求的“{name}”模块展开，写成正式文档正文。",
            "children": [],
        })

    renumbered: list[dict[str, Any]] = []
    for index, section in enumerate(normalized, start=1):
        item = dict(section)
        item["id"] = str(index)
        renumbered.append(item)
    return renumbered


def create_document_generation_state(
    *,
    doc_id: int | str,
    outline: list[dict[str, Any]],
    title: str = "",
) -> dict[str, Any]:
    normalized_outline = _normalize_document_outline(outline)
    sections = _document_outline_sections(normalized_outline)
    first_id = str(sections[0].get("id")) if sections else ""
    return {
        "doc_id": str(doc_id),
        "mode": "chunked_document",
        "title": title or "正式文档",
        "outline": normalized_outline,
        "current_section_id": first_id,
        "completed_sections": [],
        "chunk_index": 0,
        "last_output_tail": "",
        "full_markdown": "",
        "is_final_chunk": False,
        "estimated_total_chunks": len(sections),
        "status": "generating",
    }


def _current_generation_section(generation_state: dict[str, Any]) -> dict[str, Any]:
    current_id = str((generation_state or {}).get("current_section_id") or "").strip()
    for section in _document_outline_sections((generation_state or {}).get("outline") or []):
        if str(section.get("id") or "").strip() == current_id:
            return section
    sections = _document_outline_sections((generation_state or {}).get("outline") or [])
    return sections[0] if sections else {}


def _clip_text(text: str, limit: int) -> str:
    value = re.sub(r"\s+", " ", str(text or "")).strip()
    if len(value) <= limit:
        return value
    return value[: max(0, limit - 1)].rstrip() + "…"


def _extract_required_sections(content: str, outline: list[dict[str, Any]] | None = None) -> list[str]:
    text = str(content or "")
    candidates = [
        "身份认证", "统一身份认证", "权限管理", "数据加密", "日志审计", "漏洞管理", "灾备方案",
        "等级保护三级", "数据安全法", "个人信息保护法", "公交支付", "校园支付", "停车管理", "电子钱包",
        "项目概述", "功能需求", "非功能需求", "系统架构", "数据库设计", "接口设计", "部署方案", "测试方案",
    ]
    required: list[str] = []
    for item in candidates:
        if item in text and item not in required:
            required.append(item)
    if not required:
        for section in _document_outline_sections(outline or []):
            title = str(section.get("title") or "").strip()
            if title and title not in required:
                required.append(title)
            if len(required) >= 8:
                break
    return required[:12]


def _outline_neighbor_titles(generation_state: dict[str, Any]) -> tuple[str, str]:
    sections = _document_outline_sections((generation_state or {}).get("outline") or [])
    current_id = str((generation_state or {}).get("current_section_id") or "").strip()
    current_index = next((idx for idx, section in enumerate(sections) if str(section.get("id") or "") == current_id), -1)
    previous_title = str(sections[current_index - 1].get("title") or "") if current_index > 0 else ""
    next_title = str(sections[current_index + 1].get("title") or "") if 0 <= current_index < len(sections) - 1 else ""
    return previous_title, next_title


def _section_slice(section: dict[str, Any]) -> dict[str, Any]:
    children = []
    for child in (section or {}).get("children") or []:
        if not isinstance(child, dict):
            continue
        children.append({
            "id": str(child.get("id") or "")[:24],
            "title": _clip_text(str(child.get("title") or ""), 48),
            "goal": _clip_text(str(child.get("writing_goal") or child.get("goal") or ""), 100),
        })
        if len(children) >= 5:
            break
    return {
        "id": str((section or {}).get("id") or ""),
        "title": _clip_text(str((section or {}).get("title") or ""), 80),
        "level": int((section or {}).get("level") or 1) if str((section or {}).get("level") or "1").isdigit() else 1,
        "goal": _clip_text(str((section or {}).get("writing_goal") or (section or {}).get("goal") or ""), 220),
        "children": children,
    }


def build_document_prompt_budget(
    *,
    user_prompt: str,
    outline_text: str = "",
    state_text: str = "",
    tail_text: str = "",
    system_prompt_chars: int = 0,
    max_allowed_chars: int = 8000,
) -> dict[str, Any]:
    user_prompt_chars = len(str(user_prompt or ""))
    outline_chars = len(str(outline_text or ""))
    state_chars = len(str(state_text or ""))
    tail_chars = len(str(tail_text or ""))
    total_chars = int(system_prompt_chars or 0) + user_prompt_chars + outline_chars + state_chars + tail_chars
    compressed = user_prompt_chars > 3000 or outline_chars > 800 or tail_chars > 500 or total_chars > int(max_allowed_chars * 0.85)
    status = "overflow_blocked" if total_chars > max_allowed_chars else ("compressed" if compressed else "ok")
    return {
        "system_prompt_chars": int(system_prompt_chars or 0),
        "user_prompt_chars": user_prompt_chars,
        "outline_chars": outline_chars,
        "state_chars": state_chars,
        "tail_chars": tail_chars,
        "total_chars": total_chars,
        "max_allowed_chars": int(max_allowed_chars),
        "budget_status": status,
    }


def build_document_chunk_input(
    *,
    content: str,
    generation_state: dict[str, Any],
    conversation_id: int,
    user_id: int,
    attachment_context: str = "",
) -> str:
    current_section = _current_generation_section(generation_state)
    outline_sections = _document_outline_sections((generation_state or {}).get("outline") or [])
    completed = [str(item) for item in (generation_state or {}).get("completed_sections") or []]
    tail = str((generation_state or {}).get("last_output_tail") or "")[-500:]
    is_final = bool((generation_state or {}).get("is_final_chunk"))
    previous_title, next_title = _outline_neighbor_titles(generation_state)
    section_slice = _section_slice(current_section)
    required_sections = _extract_required_sections(content, outline_sections)
    request_summary = _clip_text(content, 800)
    lines = [
        "你是文档章节续写器，只生成当前章节的 markdown 正文。",
        "不要调用 document_render_docx、document_task_status、download_url 或任何工具。",
        "禁止输出“下面继续”“第 2 段开始”“由于篇幅限制”“我将分几次生成”“未完待续”。",
        "不能重写前文，不要跳章，不要总结全文，不要输出分段说明、模型自述或 JSON。",
        "当前章节完成时，末尾单独输出内部标记：<!--SECTION_COMPLETE:%s-->" % (section_slice.get("id") or ""),
        f"conversation_id={int(conversation_id)}",
        f"user_id={int(user_id)}",
        f"当前 cursor/current_section_id：{generation_state.get('current_section_id') or ''}",
        "",
        f"文档标题：{generation_state.get('title') or _default_outline_title(content)}",
        f"用户需求摘要：{request_summary}",
        f"必备模块：{('、'.join(required_sections) if required_sections else '按用户需求覆盖')}",
        f"当前章节：{json.dumps(section_slice, ensure_ascii=False)}",
        f"上一章节：{previous_title or '无'}",
        f"下一章节：{next_title or '无'}",
        f"已完成章节：{', '.join(completed) if completed else '无'}",
        f"chunk_index：{generation_state.get('chunk_index', 0)}；is_final_chunk：{str(is_final).lower()}",
        "",
        "上一段输出末尾 continuation context：",
        tail or "无",
    ]
    if attachment_context:
        lines.extend(["", "附件摘要：", _clip_text(attachment_context, 500)])
    lines.extend([
        "",
        "本次任务：从上一段尾部自然续写当前章节。非最终章节禁止全文总结。",
    ])
    return "\n".join(lines).strip()


def constrain_document_summary(text: str, *, max_chars: int = 150) -> str:
    source = prepare_document_text_for_display(text)
    source = _strip_full_document_code_fence(source)
    if len(source) > 300 or re.search(r"(^|\n)\s*#{1,6}\s|第[一二三四五六七八九十\d]+章|<!--SECTION_COMPLETE:", source):
        return "我会根据你的要求生成结构完整的正式文档，覆盖指定法规要求和核心模块。接下来将按章节连续输出正文，并在全文完成后生成可下载文档。"
    lines = []
    for raw in source.splitlines():
        line = raw.strip(" #*\t\r\n")
        if not line or re.search(r"第[一二三四五六七八九十\d]+章|^[-*]\s+", line):
            continue
        lines.append(line)
        if len("".join(lines)) >= max_chars:
            break
    summary = re.sub(r"\s+", " ", " ".join(lines)).strip()
    if not summary:
        summary = "我会根据你的要求生成结构完整的正式文档，并在正文完成后生成可下载文档。"
    return summary[:max_chars].rstrip()


def clean_document_chunk_output(text: str) -> str:
    source = prepare_document_text_for_display(text)
    source = _strip_full_document_code_fence(source)
    source = _remove_openclaw_empty_placeholder(source)
    source = _remove_document_section_complete_markers(source)
    forbidden = [
        r"^\s*下面继续[：:]?\s*",
        r"^\s*第\s*\d+\s*段开始[：:]?\s*",
        r"由于篇幅限制[，,。]?",
        r"我将分几次生成[，,。]?",
        r"未完待续[。.]?",
    ]
    for pattern in forbidden:
        source = re.sub(pattern, "", source, flags=re.IGNORECASE | re.MULTILINE)
    return _drop_footer_metadata_lines(source).strip()


def update_document_generation_state(
    generation_state: dict[str, Any],
    chunk_text: str,
    *,
    stop_reason: str = "",
    tail_chars: int = 800,
) -> dict[str, Any]:
    state = dict(generation_state or {})
    outline = _document_outline_sections(state.get("outline") or [])
    current_id = str(state.get("current_section_id") or "").strip()
    completed = [str(item) for item in state.get("completed_sections") or []]
    clean_chunk = clean_document_chunk_output(chunk_text)
    full_markdown = clean_document_chunk_output(str(state.get("full_markdown") or ""))
    if clean_chunk:
        full_markdown = f"{full_markdown.rstrip()}\n\n{clean_chunk.strip()}".strip()
    should_continue = should_continue_document_chunk(state, stop_reason=stop_reason, chunk_text=clean_chunk)
    if current_id and current_id not in completed and not should_continue:
        completed.append(current_id)
    remaining = [section for section in outline if str(section.get("id") or "") not in completed]
    next_id = current_id if should_continue else (str(remaining[0].get("id")) if remaining else "")
    state.update({
        "completed_sections": completed,
        "current_section_id": next_id,
        "chunk_index": int(state.get("chunk_index") or 0) + 1,
        "last_output_tail": full_markdown[-max(300, min(tail_chars, 800)):],
        "full_markdown": full_markdown,
        "last_stop_reason": str(stop_reason or "").strip().lower(),
        "is_final_chunk": not bool(next_id) and not should_continue,
        "estimated_total_chunks": int(state.get("estimated_total_chunks") or len(outline)),
        "status": "generating" if should_continue else ("completed" if not next_id else "generating"),
    })
    return state


def extract_openclaw_stop_reason(payload: Any) -> str:
    found: list[str] = []

    def walk(value: Any) -> None:
        if found:
            return
        if isinstance(value, dict):
            for key in ("stopReason", "stop_reason", "finish_reason", "finishReason"):
                reason = value.get(key)
                if reason:
                    found.append(str(reason).strip().lower())
                    return
            for nested in value.values():
                walk(nested)
                if found:
                    return
        elif isinstance(value, list):
            for nested in value:
                walk(nested)
                if found:
                    return

    walk(payload)
    return found[0] if found else ""


def should_continue_document_chunk(
    generation_state: dict[str, Any] | None,
    *,
    stop_reason: str = "",
    chunk_text: str = "",
) -> bool:
    reason = str(stop_reason or "").strip().lower()
    if reason in {"length", "max_tokens", "max_token", "token_limit", "context_length"}:
        return True
    text = str(chunk_text or "").strip()
    if not text:
        return False
    incomplete_tails = ("，", "、", "：", "；", "（", "(", "的", "和", "与", "及", "说明", "应急")
    if text.endswith(incomplete_tails) and (generation_state or {}).get("current_section_id"):
        return True
    return False


def extract_openclaw_prompt_error(payload: Any) -> dict[str, str]:
    found: list[str] = []

    def walk(value: Any) -> None:
        if found:
            return
        if isinstance(value, dict):
            for key in ("promptError", "prompt_error", "errorMessage", "error_message", "errorBody", "error_body", "error", "message"):
                raw = value.get(key)
                if isinstance(raw, str) and raw.strip():
                    raw_text = raw.strip()
                    if key in {"errorBody", "error_body"}:
                        try:
                            parsed = json.loads(raw_text)
                        except Exception:
                            parsed = None
                        if isinstance(parsed, dict):
                            walk(parsed)
                            if found:
                                return
                    found.append(raw_text)
                    return
                if isinstance(raw, dict):
                    walk(raw)
                    if found:
                        return
            for nested in value.values():
                walk(nested)
                if found:
                    return
        elif isinstance(value, list):
            for nested in value:
                walk(nested)
                if found:
                    return

    walk(payload)
    message = found[0] if found else ""
    lowered = message.lower()
    if not message:
        return {"error_type": "", "message": ""}
    if (
        "context overflow" in lowered
        or "prompt too large" in lowered
        or "context_length" in lowered
        or "context size has been exceeded" in lowered
        or "context size exceeded" in lowered
    ):
        error_type = "context_overflow"
    elif "precheck" in lowered:
        error_type = "precheck_failed"
    else:
        error_type = "openclaw_error"
    return {"error_type": error_type, "message": message}


def classify_openclaw_provider_error(exc: Any, *, provider_url: str = "") -> dict[str, str]:
    message = str(exc or "")
    lowered = message.lower()
    if (
        "context overflow" in lowered
        or "prompt too large" in lowered
        or "context size has been exceeded" in lowered
        or "context size exceeded" in lowered
    ):
        error_type = "context_overflow"
    elif isinstance(exc, ConnectionRefusedError) or "econnrefused" in lowered or "connection refused" in lowered:
        error_type = "connection_refused"
    elif "timeout" in lowered or "timed out" in lowered:
        error_type = "timeout"
    elif "empty" in lowered or "no content" in lowered:
        error_type = "empty_response"
    elif "network" in lowered or "urlopen error" in lowered:
        error_type = "network_error"
    else:
        error_type = "provider_error"
    display = "192.168.1.212:8081"
    match = re.search(r"(\d+\.\d+\.\d+\.\d+:\d+)", provider_url)
    if match:
        display = match.group(1)
    if error_type == "context_overflow":
        user_message = "当前文档生成请求过大，已触发上下文限制，未生成正文。"
    else:
        user_message = f"大模型服务当前不可用，请检查 {display}"
    return {
        "error_type": error_type,
        "message": user_message,
        "raw_error": message,
        "provider_url": provider_url,
    }


def _openclaw_provider_details(agent_id: str = "docgen") -> dict[str, str]:
    configured = str(os.getenv("OPENCLAW_PROVIDER_BASE_URL") or "").strip()
    if configured:
        return {"provider_url": configured.rstrip("/"), "model": str(os.getenv("OPENCLAW_PROVIDER_MODEL") or "").strip()}
    config_path = Path(os.getenv("OPENCLAW_CONFIG_PATH") or (Path.home() / ".openclaw/openclaw.json"))
    try:
        cfg = json.loads(config_path.read_text(encoding="utf-8"))
    except Exception:
        return {"provider_url": "", "model": ""}
    agents = ((cfg.get("agents") or {}).get("list") or [])
    model = ""
    for agent in agents:
        if isinstance(agent, dict) and str(agent.get("id") or "") == agent_id:
            model = str(agent.get("model") or "").strip()
            break
    if not model:
        model = str((((cfg.get("agents") or {}).get("defaults") or {}).get("model") or {}).get("primary") or "").strip()
    provider_name = model.split("/", 1)[0] if "/" in model else ""
    provider = (
        ((cfg.get("models") or {}).get("providers") or {}).get(provider_name)
        or ((cfg.get("tools") or {}).get("providers") or {}).get(provider_name)
        or {}
    )
    provider_url = str(provider.get("baseUrl") or provider.get("baseURL") or "").strip().rstrip("/")
    model_name = model.split("/", 1)[1] if "/" in model else model
    return {"provider_url": provider_url, "model": model_name}


def _get_json(url: str, headers: dict[str, str] | None = None, timeout_seconds: int = 5) -> tuple[int, dict[str, Any], str]:
    req = request.Request(url, headers=headers or {}, method="GET")
    try:
        with request.urlopen(req, timeout=timeout_seconds) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            payload = json.loads(raw) if raw.strip().startswith("{") else {}
            return int(getattr(resp, "status", 200) or 200), payload, raw
    except error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        payload = json.loads(raw) if raw.strip().startswith("{") else {}
        return int(exc.code or 500), payload, raw


def preflight_openclaw_provider(
    *,
    agent_id: str = "docgen",
    timeout_seconds: int = 5,
) -> dict[str, Any]:
    details = _openclaw_provider_details(agent_id)
    provider_url = details.get("provider_url") or ""
    model = details.get("model") or ""
    if not provider_url:
        return {"ok": True, "provider_url": "", "model": model, "skipped": True}
    base_no_v1 = re.sub(r"/v1/?$", "", provider_url)
    headers = {"Authorization": f"Bearer {os.getenv('OPENCLAW_PROVIDER_API_KEY') or 'local'}", "Content-Type": "application/json"}
    stages = [
        ("health", "GET", f"{base_no_v1}/health", None),
        ("models", "GET", f"{provider_url}/models", None),
        ("chat_completions", "POST", f"{provider_url}/chat/completions", {
            "model": model,
            "messages": [{"role": "user", "content": "请只回复 OK"}],
            "max_tokens": 8,
            "temperature": 0,
            "stream": False,
        }),
    ]
    for stage, method, url, body in stages:
        try:
            if method == "GET":
                status_code, payload, raw = _get_json(url, headers=headers, timeout_seconds=timeout_seconds)
            else:
                status_code, payload, raw = _post_json(url, headers, body or {}, timeout_seconds)
            if status_code >= 400:
                err = RuntimeError(f"{stage} returned http {status_code}: {raw[:200]}")
                classified = classify_openclaw_provider_error(err, provider_url=provider_url)
                return {"ok": False, "stage": stage, **classified}
            if stage == "chat_completions":
                text = extract_response_text(payload)
                choices = payload.get("choices") if isinstance(payload, dict) else None
                if not text and isinstance(choices, list) and choices:
                    text = extract_response_text(choices[0])
                    if not text and isinstance(choices[0], dict):
                        message = choices[0].get("message") if isinstance(choices[0].get("message"), dict) else {}
                        text = str(message.get("reasoning_content") or "").strip()
                if not text:
                    classified = classify_openclaw_provider_error(RuntimeError("empty response"), provider_url=provider_url)
                    return {"ok": False, "stage": stage, **classified}
        except Exception as exc:
            classified = classify_openclaw_provider_error(exc, provider_url=provider_url)
            return {"ok": False, "stage": stage, **classified}
    return {"ok": True, "provider_url": provider_url, "model": model, "stage": "chat_completions"}


def _strip_outer_separators(text: str) -> str:
    lines = [line.rstrip() for line in str(text or "").split("\n")]
    separator = re.compile(r"^\s*(?:-{3,}|─{3,}|—{3,}|_{3,})\s*$")
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and separator.match(lines[0]):
        lines.pop(0)
        while lines and not lines[0].strip():
            lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    while lines and separator.match(lines[-1]):
        lines.pop()
        while lines and not lines[-1].strip():
            lines.pop()
    return "\n".join(lines).strip()


def prepare_document_text_for_display(text: str) -> str:
    cleaned = _strip_document_tail(text)
    cleaned = _strip_full_document_code_fence(cleaned)
    cleaned = _remove_document_section_complete_markers(cleaned)
    cleaned = _drop_footer_metadata_lines(cleaned)
    return _strip_outer_separators(cleaned)


def _strip_leading_summary(text: str) -> str:
    source = str(text or "").strip()
    if not source:
        return ""
    heading = re.search(r"(?m)^#(?!#)\s+\S.*$", source)
    if heading:
        return source[heading.start():].strip()
    lines = source.split("\n")
    first_nonempty = next((index for index, line in enumerate(lines) if line.strip()), None)
    if first_nonempty is None:
        return ""
    first_line = lines[first_nonempty].strip()
    looks_like_summary = bool(re.search(r"(小总结|简要总结|摘要|本周总结|总结)", first_line))
    separator = re.compile(r"^\s*(?:-{3,}|─{3,}|—{3,}|_{3,})\s*$")
    if looks_like_summary:
        for index in range(first_nonempty + 1, min(len(lines), first_nonempty + 12)):
            if separator.match(lines[index]):
                return "\n".join(lines[index + 1:]).strip()
        for index in range(first_nonempty + 1, min(len(lines), first_nonempty + 8)):
            if not lines[index].strip():
                return "\n".join(lines[index + 1:]).strip()
    return source


def prepare_document_markdown_for_render(text: str) -> str:
    display_text = prepare_document_text_for_display(text)
    display_text = _strip_full_document_code_fence(display_text)
    body = _strip_leading_summary(display_text)
    body = _drop_footer_metadata_lines(body)
    return _strip_outer_separators(body)


def extract_document_task_payload(payload: Any) -> dict[str, Any] | None:
    if isinstance(payload, dict):
        task_id = payload.get("task_id")
        status = payload.get("status")
        if task_id and status:
            result = {
                "task_id": str(task_id),
                "status": str(status),
                "workflow_type": str(payload.get("workflow_type") or "document"),
            }
            for key in ("title", "progress", "download_url", "file_id", "file", "status_text", "stage"):
                if key in payload:
                    result[key] = payload.get(key)
            return result
        for value in payload.values():
            result = extract_document_task_payload(value)
            if result:
                return result
    elif isinstance(payload, list):
        for item in payload:
            result = extract_document_task_payload(item)
            if result:
                return result
    return None


