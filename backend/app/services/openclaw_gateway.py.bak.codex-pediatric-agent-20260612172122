def _openclaw_cfg() -> dict[str, Any]:
    cfg = (get_config().get("openclaw") or {}) if isinstance(get_config(), dict) else {}
    enabled_raw = os.getenv("OPENCLAW_ENABLED")
    if enabled_raw is None:
        enabled = bool(cfg.get("enabled"))
    else:
        enabled = enabled_raw.strip().lower() in {"1", "true", "yes", "on"}
    timeout = os.getenv("OPENCLAW_TIMEOUT_SECONDS") or cfg.get("timeout_seconds") or 180
    try:
        timeout = int(timeout)
    except Exception:
        timeout = 180
    task_wait_seconds = os.getenv("OPENCLAW_TASK_WAIT_SECONDS") or cfg.get("task_wait_seconds") or 45
    try:
        task_wait_seconds = int(task_wait_seconds)
    except Exception:
        task_wait_seconds = 45
    poll_seconds = os.getenv("OPENCLAW_TASK_POLL_SECONDS") or cfg.get("task_poll_seconds") or 1.0
    try:
        poll_seconds = float(poll_seconds)
    except Exception:
        poll_seconds = 1.0
    return {
        "enabled": enabled,
        "gateway_base_url": str(
            os.getenv("OPENCLAW_GATEWAY_BASE_URL")
            or cfg.get("gateway_base_url")
            or "http://127.0.0.1:18789"
        ).rstrip("/"),
        "gateway_token": str(os.getenv("OPENCLAW_GATEWAY_TOKEN") or cfg.get("gateway_token") or "").strip(),
        "chat_model": str(
            os.getenv("OPENCLAW_CHAT_MODEL")
            or cfg.get("chat_model")
            or "openclaw"
        ).strip() or "openclaw",
        "chat_agent_id": str(
            os.getenv("OPENCLAW_CHAT_AGENT_ID")
            or cfg.get("chat_agent_id")
            or "main"
        ).strip() or "main",
        "knowledge_model": str(
            os.getenv("OPENCLAW_KNOWLEDGE_MODEL")
            or cfg.get("knowledge_model")
            or cfg.get("chat_model")
            or "openclaw"
        ).strip() or "openclaw",
        "knowledge_agent_id": str(
            os.getenv("OPENCLAW_KNOWLEDGE_AGENT_ID")
            or cfg.get("knowledge_agent_id")
            or cfg.get("chat_agent_id")
            or "main"
        ).strip() or "main",
        "document_model": str(
            os.getenv("OPENCLAW_DOCUMENT_MODEL")
            or cfg.get("document_model")
            or "openclaw/docgen"
        ).strip() or "openclaw/docgen",
        "document_agent_id": str(
            os.getenv("OPENCLAW_DOCUMENT_AGENT_ID")
            or cfg.get("document_agent_id")
            or "docgen"
        ).strip() or "docgen",
        "timeout_seconds": max(10, timeout),
        "task_wait_seconds": max(5, task_wait_seconds),
        "task_poll_seconds": max(0.2, poll_seconds),
    }


