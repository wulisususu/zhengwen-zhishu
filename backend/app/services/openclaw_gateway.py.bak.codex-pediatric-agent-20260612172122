def _normalize_int_list(values: list[int] | None) -> list[int]:
    normalized: list[int] = []
    for item in values or []:
        try:
            value = int(item)
        except Exception:
            continue
        if value > 0 and value not in normalized:
            normalized.append(value)
    return normalized


def _is_explicit_tts_request(content: str) -> bool:
    text = str(content or "").strip()
    if not text:
        return False
    patterns = [
        r"读出来",
        r"念出来",
        r"读给我听",
        r"念给我听",
        r"朗读",
        r"播报",
        r"播放.*语音",
        r"生成.*语音",
        r"\bTTS\b",
    ]
    return any(re.search(pattern, text, flags=re.IGNORECASE) for pattern in patterns)


def _is_explicit_asr_request(content: str) -> bool:
    text = str(content or "").strip()
    if not text:
        return False
    patterns = [
        r"转写",
        r"识别.*音频",
        r"识别.*语音",
        r"听写",
        r"字幕",
        r"音频.*转成文字",
        r"语音.*转成文字",
        r"录音.*转成文字",
    ]
    return any(re.search(pattern, text, flags=re.IGNORECASE) for pattern in patterns)


def build_chat_input(
    content: str,
