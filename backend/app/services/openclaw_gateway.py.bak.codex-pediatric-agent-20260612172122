def should_use_document_chunk_mode(
    content: str,
    *,
    estimated_sections: int = 0,
    estimated_chars: int = 0,
    max_tokens_risk: bool = False,
) -> bool:
    text = str(content or "")
    if not text.strip():
        return False
    if max_tokens_risk:
        return True
    if estimated_sections and estimated_sections > 5:
        return True
    if estimated_chars and estimated_chars >= 3000:
        return True
    if re.search(r"(不少于|至少|超过|大于)?\s*[3-9]\d{3,}\s*(字|中文字|字符)", text):
        return True
    if re.search(r"(不少于|至少|超过|大于)?\s*[1-9]\d{4,}\s*(字|中文字|字符)", text):
        return True
    chapter_matches = re.findall(r"第[一二三四五六七八九十\d]+章|(?:^|\n)\s*\d+[\.、]\s*\S+", text)
    if len(chapter_matches) > 5:
        return True
    lowered = text.lower()
    return any(keyword.lower() in lowered for keyword in _LONG_DOCUMENT_KEYWORDS)


