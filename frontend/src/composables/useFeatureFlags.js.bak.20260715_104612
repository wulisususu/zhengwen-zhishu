import { ref } from 'vue'
import { getFeatureFlags } from '../api.js'

const flags = ref({ show_ppt: false, show_table: false, show_agents: true })
let loaded = false

export function useFeatureFlags() {
  async function load() {
    if (loaded) return
    try {
      const res = await getFeatureFlags()
      flags.value = res.data || flags.value
      loaded = true
    } catch (e) {
      console.warn('feature flags load failed', e)
    }
  }
  return { flags, load }
}

