<template>
  <main class="flex h-dvh flex-col overflow-hidden bg-[#f6f7f8] text-black">
    <AppHeader title="欢迎2" subtitle="聊天" @goHome="router.push('/')" @logout="router.push('/login')" />

    <div class="flex min-h-0 flex-1">
      <aside class="hidden w-[272px] shrink-0 border-r border-[#E6EAF2] bg-[rgba(255,255,255,0.92)] px-3 py-4 shadow-[0_2px_10px_rgba(16,24,40,0.04)] backdrop-blur-sm md:flex md:min-h-0 md:flex-col">
        <nav class="shrink-0 space-y-1.5 pb-5">
          <button @click="createNewChat"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <Plus class="size-4" :stroke-width="2" />
            <span>新聊天</span>
          </button>
          <button class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <Search class="size-4" :stroke-width="2" />
            <span>搜索聊天</span>
          </button>
          <button
            class="flex h-11 w-full items-center gap-3 rounded-[14px] border border-[rgba(94,106,210,0.10)] bg-[#EEF2FF] px-3.5 text-left text-[14px] font-medium text-[#5E6AD2] shadow-[0_1px_2px_rgba(16,24,40,0.04)] transition-all duration-150">
            <MessageSquare class="size-4" :stroke-width="2" />
            <span>聊天</span>
          </button>
          <button @click="router.push('/document')"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <FileText class="size-4" :stroke-width="2" />
            <span>写文档</span>
          </button>
          <button @click="router.push({ path: '/workspace', query: { mode: 'document' } })"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <FolderOpen class="size-4" :stroke-width="2" />
            <span>文档库</span>
          </button>
          <button @click="router.push({ path: '/workspace', query: { mode: 'knowledge' } })"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <Database class="size-4" :stroke-width="2" />
            <span>知识库</span>
          </button>
        </nav>

        <section class="mt-2 flex min-h-0 flex-1 flex-col">
          <h2 class="shrink-0 px-2.5 pb-2 text-[13px] font-semibold leading-5 text-black">最近</h2>
          <div ref="historyScroller" class="min-h-0 flex-1 space-y-1.5 overflow-y-auto pr-1" @scroll="onHistoryScroll">
            <button v-for="c in chat.conversations" :key="c.id" @click="selectConversation(c.id)"
              :class="['block h-9 w-full rounded-[8px] px-2.5 text-left text-[14px] leading-9 transition-colors',
                chat.currentConvId === c.id ? 'bg-black/[0.06] text-black' : 'text-black/85 hover:bg-black/[0.06]']">
              <span class="block truncate font-medium">{{ c.title }}</span>
            </button>
            <div v-if="chat.conversationsLoading" class="px-2.5 py-2 text-[12px] text-black/35">加载中...</div>
            <div v-else-if="!chat.conversations.length" class="px-2.5 py-2 text-[13px] text-black/35">暂无对话</div>
          </div>
        </section>
      </aside>

      <section class="flex min-w-0 flex-1 flex-col">
        <div class="flex items-center gap-2 overflow-x-auto border-b border-black/[0.08] bg-white px-3 py-2 md:hidden">
          <button class="h-9 shrink-0 rounded-[8px] bg-[#232629] px-3 text-[14px] text-white">聊天</button>
          <button @click="router.push('/document')" class="h-9 shrink-0 rounded-[8px] bg-black/[0.04] px-3 text-[14px] text-black/65">写文档</button>
          <button @click="router.push({ path: '/workspace', query: { mode: 'document' } })" class="h-9 shrink-0 rounded-[8px] bg-black/[0.04] px-3 text-[14px] text-black/65">文档库</button>
          <button @click="router.push({ path: '/workspace', query: { mode: 'knowledge' } })" class="h-9 shrink-0 rounded-[8px] bg-black/[0.04] px-3 text-[14px] text-black/65">知识库</button>
        </div>

        <div class="min-h-0 flex-1 overflow-hidden p-4 md:p-5">
          <ChatMode workflow="chat" route-base="/chat" active-title="当前对话" idle-title="开始聊天" empty-text="开始新的对话" />
        </div>
      </section>
    </div>
  </main>
</template>

<script setup>
import { onMounted, ref, watch } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { Database, FileText, FolderOpen, MessageSquare, Plus, Search } from 'lucide-vue-next'
import AppHeader from '../components/AppHeader.vue'
import ChatMode from '../components/ChatMode.vue'
import { useChatStore } from '../stores/chat.js'

const route = useRoute()
const router = useRouter()
const chat = useChatStore()
const historyScroller = ref(null)

onMounted(async () => {
  await chat.loadConversations(50, 'chat')
  await syncRouteState()
})

watch(() => route.fullPath, () => {
  syncRouteState()
})

async function createNewChat() {
  if (!chat.currentConvId && !chat.messages.length) {
    if (route.path !== '/chat') router.replace('/chat')
    return
  }
  chat.startNewConversation()
  window.dispatchEvent(new CustomEvent('mqw-workspace-reset'))
  await router.push('/chat')
}

async function selectConversation(id) {
  const conv = chat.conversations.find((c) => c.id === id)
  const ok = await chat.selectConversation(id, conv?.workflow_type || 'chat')
  if (ok && route.path !== `/chat/${id}`) await router.push(`/chat/${id}`)
  if (!ok) await router.replace('/chat')
}

function routeConversationId() {
  const raw = route.params.id
  const value = Array.isArray(raw) ? raw[0] : raw
  const id = Number(value)
  return Number.isInteger(id) && id > 0 ? id : null
}

async function syncRouteState() {
  const id = routeConversationId()
  if (id) {
    if (chat.currentConvId !== id) {
      const conv = chat.conversations.find((c) => c.id === id)
      const ok = await chat.selectConversation(id, conv?.workflow_type || '')
      if (!ok) {
        chat.startNewConversation()
        window.dispatchEvent(new CustomEvent('mqw-workspace-reset'))
        await router.replace('/chat')
      }
    }
  } else if (chat.currentConvId || chat.messages.length) {
    chat.startNewConversation()
    window.dispatchEvent(new CustomEvent('mqw-workspace-reset'))
  }
}

function onHistoryScroll(event) {
  const el = event.target
  if (!el || chat.conversationsLoading || !chat.conversationsHasMore) return
  if (el.scrollTop + el.clientHeight >= el.scrollHeight - 48) {
    chat.loadMoreConversations(20, 'chat')
  }
}
</script>
