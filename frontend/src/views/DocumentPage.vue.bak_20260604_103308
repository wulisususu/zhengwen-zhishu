    <div class="flex min-h-0 flex-1">
      <aside class="hidden w-[272px] shrink-0 border-r border-[#E6EAF2] bg-[rgba(255,255,255,0.92)] px-3 py-4 shadow-[0_2px_10px_rgba(16,24,40,0.04)] backdrop-blur-sm md:flex md:min-h-0 md:flex-col">
        <nav class="shrink-0 space-y-1.5 pb-5">
          <button @click="createNewDocument"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <Plus class="size-4" :stroke-width="2" />
            <span>新文档</span>
          </button>
          <button class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <Search class="size-4" :stroke-width="2" />
            <span>搜索文档</span>
          </button>
          <button @click="router.push('/chat')"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <MessageSquare class="size-4" :stroke-width="2" />
            <span>聊天</span>
          </button>
          <button
            class="flex h-11 w-full items-center gap-3 rounded-[14px] border border-[rgba(94,106,210,0.10)] bg-[#EEF2FF] px-3.5 text-left text-[14px] font-medium text-[#5E6AD2] shadow-[0_1px_2px_rgba(16,24,40,0.04)] transition-all duration-150">
            <FileText class="size-4" :stroke-width="2" />
            <span>写文档</span>
          </button>
          <button @click="router.push({ path: '/workspace', query: { mode: 'document' } })"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <FolderOpen class="size-4" :stroke-width="2" />
            <span>文档库</span>
          </button>
          <button @click="goTable"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <Sheet class="size-4" :stroke-width="2" />
            <span>写表格</span>
          </button>
          <button @click="goKnowledge"
            class="group flex h-11 w-full items-center gap-3 rounded-[14px] border border-transparent px-3.5 text-left text-[14px] font-medium text-[#475467] transition-all duration-150 hover:border-[#E6EAF2] hover:bg-[#F6F8FC] hover:text-[#111827]">
            <Database class="size-4" :stroke-width="2" />
            <span>知识库</span>
          </button>
        </nav>

        <section class="mt-2 flex min-h-0 flex-1 flex-col">
          <h2 class="shrink-0 px-3 pb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-[#98A2B3]">最近生成</h2>
          <div ref="historyScroller" class="min-h-0 flex-1 space-y-2 overflow-y-auto pr-1" @scroll="onHistoryScroll">
            <button v-for="c in chat.conversations" :key="c.id" @click="selectConversation(c.id)"
              :class="['block w-full rounded-[12px] border px-3 py-2.5 text-left text-[13px] font-medium leading-5 transition-all duration-150',
                chat.currentConvId === c.id ? 'border-[rgba(94,106,210,0.10)] bg-[#F4F6FF] text-[#344054] shadow-[0_1px_2px_rgba(16,24,40,0.04)]' : 'border-transparent bg-transparent text-[#475467] hover:border-[#E6EAF2] hover:bg-[#F8FAFC] hover:text-[#111827]']">
              <span class="block truncate">{{ c.title }}</span>
            </button>
            <div v-if="chat.conversationsLoading" class="px-3 py-2 text-[12px] font-medium text-[#98A2B3]">加载中...</div>
            <div v-else-if="!chat.conversations.length" class="px-3 py-2 text-[13px] text-[#98A2B3]">暂无文档记录</div>
          </div>
        </section>
      </aside>

      <section class="flex min-w-0 flex-1 flex-col">
        <div class="flex items-center gap-2 overflow-x-auto border-b border-[#E6EAF2] bg-[rgba(255,255,255,0.9)] px-3 py-2 md:hidden">
          <button @click="router.push('/chat')" class="h-9 shrink-0 rounded-[10px] border border-transparent bg-transparent px-3 text-[14px] font-medium text-[#667085] hover:border-[#E6EAF2] hover:bg-[#F8FAFC] hover:text-[#111827]">聊天</button>
          <button class="h-9 shrink-0 rounded-[10px] border border-[rgba(94,106,210,0.10)] bg-[#EEF2FF] px-3 text-[14px] font-medium text-[#5E6AD2] shadow-[0_1px_2px_rgba(16,24,40,0.04)]">写文档</button>
          <button @click="router.push({ path: '/workspace', query: { mode: 'document' } })" class="h-9 shrink-0 rounded-[10px] border border-transparent bg-transparent px-3 text-[14px] font-medium text-[#667085] hover:border-[#E6EAF2] hover:bg-[#F8FAFC] hover:text-[#111827]">文档库</button>
          <button @click="goTable" class="h-9 shrink-0 rounded-[10px] border border-transparent bg-transparent px-3 text-[14px] font-medium text-[#667085] hover:border-[#E6EAF2] hover:bg-[#F8FAFC] hover:text-[#111827]">写表格</button>
          <button @click="goKnowledge" class="h-9 shrink-0 rounded-[10px] border border-transparent bg-transparent px-3 text-[14px] font-medium text-[#667085] hover:border-[#E6EAF2] hover:bg-[#F8FAFC] hover:text-[#111827]">知识库</button>
        </div>

        <div class="grid min-h-0 w-full flex-1 gap-4 overflow-hidden bg-[radial-gradient(circle_at_top,rgba(238,241,255,0.45)_0%,rgba(252,252,254,0)_28%),linear-gradient(180deg,#FCFCFE_0%,#F7F8FB_100%)] p-4 md:grid-cols-[minmax(0,1fr)_minmax(340px,424px)] md:p-5">
          <ChatMode workflow="document" route-base="/document" active-title="文档生成" idle-title="描述要写的文档" empty-text="输入文档需求后开始生成" />
          <DocumentMode />
        </div>
      </section>
    </div>
  </main>
</template>

<script setup>
import { onMounted, ref, watch } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { Database, FileText, FolderOpen, MessageSquare, Plus, Search, Sheet } from 'lucide-vue-next'
import AppHeader from '../components/AppHeader.vue'
import ChatMode from '../components/ChatMode.vue'
import DocumentMode from '../components/DocumentMode.vue'
import { useChatStore } from '../stores/chat.js'

const route = useRoute()
const router = useRouter()
const chat = useChatStore()
const historyScroller = ref(null)
const TABLE_URL = 'http://192.168.1.212:7000/'
const KNOWLEDGE_URL = 'http://192.168.1.212:2444/'

onMounted(async () => {
  await chat.loadConversations(50, 'document')
  await syncRouteState()
})

watch(() => route.fullPath, () => {
  syncRouteState()
})

async function createNewDocument() {
  if (!chat.currentConvId && !chat.messages.length) {
    if (route.path !== '/document') router.replace('/document')
    return
  }
  chat.startNewConversation()
  window.dispatchEvent(new CustomEvent('mqw-workspace-reset'))
  await router.push('/document')
}

async function selectConversation(id) {
  const ok = await chat.selectConversation(id, 'document')
  if (ok && route.path !== `/document/${id}`) await router.push(`/document/${id}`)
  if (!ok) await router.replace('/document')
}

function routeConversationId() {
  const raw = route.params.id
  const value = Array.isArray(raw) ? raw[0] : raw
  const id = Number(value)
  return Number.isInteger(id) && id > 0 ? id : null
}

async function syncRouteState() {
  const id = routeConversationId()
  if (id) {
    if (chat.currentConvId !== id) {
      const ok = await chat.selectConversation(id, 'document')
      if (!ok) {
        chat.startNewConversation()
        window.dispatchEvent(new CustomEvent('mqw-workspace-reset'))
        await router.replace('/document')
      }
    }
  } else if (chat.currentConvId || chat.messages.length) {
    chat.startNewConversation()
    window.dispatchEvent(new CustomEvent('mqw-workspace-reset'))
  }
}

function onHistoryScroll(event) {
  const el = event.target
  if (!el || chat.conversationsLoading || !chat.conversationsHasMore) return
  if (el.scrollTop + el.clientHeight >= el.scrollHeight - 48) {
    chat.loadMoreConversations(20, 'document')
  }
}

function goTable() {
  window.open(TABLE_URL, '_self')
}

function goKnowledge() {
  window.open(KNOWLEDGE_URL, '_self')
}
</script>
