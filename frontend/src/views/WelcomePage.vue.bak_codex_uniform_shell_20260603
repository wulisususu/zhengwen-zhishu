<script setup>
import { ref } from 'vue'
import { useRouter } from 'vue-router'
import { MessageSquare, FileText, Presentation, BookOpen, ChevronRight, Upload, Mic, Send } from 'lucide-vue-next'
import AppHeader from '../components/AppHeader.vue'

const router = useRouter()
const requestType = ref('word')
const requestText = ref('')

function goWorkspace(mode) {
  if (mode === 'chat') router.push('/chat')
  else if (mode === 'document') router.push('/document')
  else router.push({ path: '/workspace', query: { mode } })
}

function submitRequest() {
  const text = requestText.value.trim()
  if (text) {
    sessionStorage.setItem('mqw-pending-request', JSON.stringify({ type: requestType.value, text }))
  }
  if (requestType.value === 'ppt') window.location.href = 'http://192.168.1.212:5000/'
  else router.push('/document')
}
</script>
