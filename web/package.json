{
  "name": "mqw-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:host": "node --test src/components/*.test.mjs tests/*.test.mjs",
    "test:ppt": "vitest run",
    "test": "npm run test:host && npm run test:ppt",
    "test:browser": "vite build && node tests/browser/run.mjs"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "lucide-vue-next": "^0.460.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.2.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.0",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.48.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
